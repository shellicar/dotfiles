#!/bin/sh
#
# gpg-bridge-install: put the Windows side relay in place and hand this distro's
# gpg-agent socket to it. Installation only: gpg.conf, the Windows startup entry
# and the keyring are setup/wsl/gpg-setup.sh --configure's.
#
#   gpg-bridge-install           print the plan, touch nothing
#   gpg-bridge-install --apply   print the plan, then do it
#
# The steps are gpg_bridge_install in ../lib/gpg-bridge.sh. The undo steps are in
# docs/yubikey.md.

set -eu

DIR=$(cd "$(dirname "$0")" && pwd)

# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/gpg-bridge.sh
. "$DIR/../lib/gpg-bridge.sh"

apply=0
for arg in "$@"; do
  case "$arg" in
    --apply) apply=1 ;;
    *) echo "usage: gpg-bridge-install [--apply]" >&2; exit 2 ;;
  esac
done

gpg_bridge_install "$apply"
