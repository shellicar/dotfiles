#!/bin/sh
#
# gpg-bridge-install: put the Windows side relay in place and hand this distro's
# gpg-agent socket to it.
#
#   gpg-bridge-install           print the plan, touch nothing
#   gpg-bridge-install --apply   print the plan, then do it
#
# Idempotent: every step checks its own end state first, so a re-run after a
# partial failure resumes rather than repeating.
#
# The four packaged sockets are MASKED, not disabled. All four activate the same
# gpg-agent.service, and only one listener can own S.gpg-agent, so the packaged
# one has to go. Disabling alone is not enough: a package update or another unit
# pulling it in would quietly restore a local agent holding no keys, and gpg
# would then report a missing card rather than a broken bridge. Masking makes
# that failure impossible instead of merely unlikely. dirmngr and keyboxd are
# left alone: those are the network and public keyring services, still local.
# Reverse with: systemctl --user unmask <the four>; systemctl --user enable --now gpg-agent.socket
#
# no-autostart is written to gpg.conf for the same reason. Without it, gpg spawns
# its own agent whenever the socket is missing, so a stopped bridge looks like an
# absent key instead of an absent bridge.
#
# The relay is downloaded rather than committed: a binary in a dotfiles repo is a
# thing nobody re-checks. The release is pinned by version and verified against
# its SHA-256 before anything is unpacked, so the repo records exactly what is
# expected without carrying it.

set -eu

DIR=$(cd "$(dirname "$0")" && pwd)
TOOL='gpg-bridge-install'

# Installed, this sits in ~/bin and the library in ~/lib. Run straight from the
# repo, home/wsl/bin has no sibling lib: the serials live in home/common/lib.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../common/lib/yubikeys.sh
# shellcheck disable=SC1091  # resolved at runtime; the directive above names the repo copy
if [ -f "$DIR/../lib/yubikeys.sh" ]; then
  . "$DIR/../lib/yubikeys.sh"
else
  . "$DIR/../../common/lib/yubikeys.sh"
fi

RELAY_VERSION=v1.6.3
RELAY_URL="https://github.com/rupor-github/win-gpg-agent/releases/download/${RELAY_VERSION}/win-gpg-agent.zip"
RELAY_SHA256=23cc5e7b7e1937049ab7a416871713f44fbf84a002aa58fd6326d99876b79cd0
RELAY_MEMBER=sorelay.exe

MASKED_UNITS='gpg-agent.socket gpg-agent-extra.socket gpg-agent-ssh.socket gpg-agent-browser.socket'
SERVICE=gpg-bridge.service

apply=0
for arg in "$@"; do
  case "$arg" in
    --apply) apply=1 ;;
    *) echo "usage: $TOOL [--apply]" >&2; exit 2 ;;
  esac
done

[ -n "${WSL_DISTRO_NAME:-}" ] || { echo "$TOOL: WSL only" >&2; exit 2; }

for cmd in wslvar wslpath socat curl unzip sha256sum systemctl gpgconf gpg; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "$TOOL: missing $cmd" >&2; exit 1; }
done

win_bin=$(wslpath -u "$(wslvar USERPROFILE)")/bin
relay="$win_bin/$RELAY_MEMBER"
gpg_conf="${GNUPGHOME:-$HOME/.gnupg}/gpg.conf"

# What is already true, so the plan states only what is left to change.
need_relay=0
[ -x "$relay" ] || need_relay=1

need_mask=''
for unit in $MASKED_UNITS; do
  state=$(systemctl --user is-enabled "$unit" 2>/dev/null || true)
  [ "$state" = masked ] || need_mask="$need_mask $unit"
done

need_autostart=0
if [ ! -f "$gpg_conf" ] || ! grep -qx 'no-autostart' "$gpg_conf"; then
  need_autostart=1
fi

need_service=0
[ "$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)" = active ] || need_service=1

echo "plan: bridge gpg-agent to the Windows agent"
echo "  relay        $relay"
if [ "$need_relay" -eq 1 ]; then
  echo "               download $RELAY_VERSION and verify SHA-256"
else
  echo "               already present"
fi
echo "  socket       $(gpgconf --list-dirs agent-socket)"
if [ -n "$need_mask" ]; then
  echo "  mask        $need_mask"
else
  echo "  mask         already masked"
fi
if [ "$need_autostart" -eq 1 ]; then
  echo "  gpg.conf     add no-autostart"
else
  echo "  gpg.conf     no-autostart already set"
fi
if [ "$need_service" -eq 1 ]; then
  echo "  service      enable and start $SERVICE"
else
  echo "  service      already active"
fi
echo "  key          $GPG_FINGERPRINT"

if [ "$apply" -eq 0 ]; then
  echo "run: $TOOL --apply"
  exit 0
fi

if [ "$need_relay" -eq 1 ]; then
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT INT TERM
  echo "downloading $RELAY_VERSION"
  curl -fsSL -o "$tmp/win-gpg-agent.zip" "$RELAY_URL"
  got=$(sha256sum "$tmp/win-gpg-agent.zip" | cut -d' ' -f1)
  if [ "$got" != "$RELAY_SHA256" ]; then
    echo "$TOOL: checksum mismatch, refusing to unpack" >&2
    echo "  expected $RELAY_SHA256" >&2
    echo "  got      $got" >&2
    exit 1
  fi
  mkdir -p "$win_bin"
  unzip -o -q -j "$tmp/win-gpg-agent.zip" "$RELAY_MEMBER" -d "$win_bin"
  echo "  installed $relay"
fi

if [ -n "$need_mask" ]; then
  # Stop before masking: masking an active unit leaves it running. The service
  # goes too, not just its sockets, or the agent it already started keeps the
  # socket path and the bridge cannot listen.
  # shellcheck disable=SC2086  # deliberate split, one word per unit
  systemctl --user stop $need_mask 2>/dev/null || true
  systemctl --user stop gpg-agent.service 2>/dev/null || true
  # shellcheck disable=SC2086
  systemctl --user mask $need_mask
  echo "  masked$need_mask"
fi

if [ "$need_autostart" -eq 1 ]; then
  mkdir -p "$(dirname "$gpg_conf")"
  chmod 700 "$(dirname "$gpg_conf")"
  echo 'no-autostart' >> "$gpg_conf"
  echo "  gpg.conf no-autostart added"
fi

systemctl --user daemon-reload
systemctl --user enable --now "$SERVICE"
echo "  $SERVICE enabled"

# The card is the proof, not the unit being active: an active socat with a
# broken Windows side still looks healthy from systemd's point of view.
if gpg --card-status >/dev/null 2>&1; then
  echo "card reachable through the bridge"
else
  echo "$TOOL: bridge up but the card did not answer" >&2
  echo "  check the key is in the dock and Windows gpg-agent is running:" >&2
  echo "    gpg --card-status" >&2
  exit 1
fi

if gpg --list-keys "$GPG_FINGERPRINT" >/dev/null 2>&1; then
  echo "public key present"
else
  echo "public key $GPG_FINGERPRINT is NOT in this keyring"
  echo "  signatures will verify as unknown until it is imported. On Windows:"
  echo "    gpg --export --armor $GPG_FINGERPRINT > %TEMP%\\pub.asc"
  echo "  then here:"
  echo "    gpg --import \"\$(wslpath -u \"\$(wslvar TEMP)\")/pub.asc\""
  printf '    %s\n' "printf '%s:6:\\n' $GPG_FINGERPRINT | gpg --import-ownertrust"
fi
