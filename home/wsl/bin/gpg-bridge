#!/bin/sh
#
# gpg-bridge: serve this distro's gpg-agent socket from the Windows gpg-agent
# that holds the YubiKey. Run by gpg-bridge.service.
#
# The Windows agent listens on Windows' 127.0.0.1, which WSL cannot reach, so
# sorelay.exe runs on the Windows side, does the Assuan nonce handshake (-a), and
# carries the data to socat over stdio. See docs/yubikey.md.
#
# The socket path must come from gpgconf: a relay in ~/.gnupg is silently ignored.

set -eu

# wslvar costs about 200ms, so it runs once at start, not per connection.
RELAY="${GPG_BRIDGE_RELAY:-$(wslpath -u "$(wslvar USERPROFILE)")/bin/sorelay.exe}"

if [ ! -x "$RELAY" ]; then
  echo "gpg-bridge: relay not found or not executable: $RELAY" >&2
  echo "  run gpg-bridge-install --apply" >&2
  exit 1
fi

# sorelay wants forward slashes. The colon is escaped because socat parses the
# EXEC argument and treats ':' as a separator.
# shellcheck disable=SC1003  # '\\' is one backslash for tr, not an escaped quote
win_local=$(wslvar LOCALAPPDATA | tr '\\' '/')
win_socket=$(echo "${win_local}/gnupg/S.gpg-agent" | sed 's/:/\\:/')

# gpg refuses to use a socket directory it did not create with the right mode.
gpgconf --create-socketdir >/dev/null 2>&1 || true

socket=$(gpgconf --list-dirs agent-socket)

# unlink-early clears a socket left by an unclean exit.
exec socat "UNIX-LISTEN:${socket},fork,unlink-early" "EXEC:${RELAY} -a ${win_socket},nofork"
