#!/bin/sh
# vscode-open-workspace <name> <workspace-file>
#
# Opens <workspace-file> in Windows VS Code unless a VS Code window whose title
# starts with "<name> - " is already open. The workspace file sets that title.
#
# Running `code` on a workspace that is already open makes its window flash, and
# the tmux focus hook calls this on every pane switch, hence the check first.
#
# The check takes about half a second, and the hook's run-shell waits for this
# command, so the call from the hook only starts a detached copy of itself and
# returns. The copy does the check and the open. No `&` and no `run-shell -b`:
# each would be another process under tmux on every focus. `setsid -f` is the
# one fork, and it exits at once.
#
# Always exits 0: the hook's exit status is this command's, and tmux puts the
# pane in view mode on every focus when a run-shell exits non-zero. Failures go
# to stderr, which ends up in the hook's log.

NL='
'
# TODO(claude): undecided: whether the log path can be changed from the environment. It can, so the tests write their own log rather than the hook's.
LOG=${VSCODE_OPEN_WORKSPACE_LOG:-/tmp/tmux-vscode-workspace.log}

if [ $# -ne 2 ]; then
  echo "usage: vscode-open-workspace <name> <workspace-file>" >&2
  exit 0
fi
NAME=$1
WS_FILE=$2

# The first call: start the copy and return. The variable marks the copy.
if [ -z "${VSCODE_OPEN_WORKSPACE_DETACHED:-}" ]; then
  VSCODE_OPEN_WORKSPACE_DETACHED=1 setsid -f "$0" "$NAME" "$WS_FILE" < /dev/null >> "$LOG" 2>&1 ||
    echo "vscode-open-workspace: could not start the detached check" >&2
  exit 0
fi
unset VSCODE_OPEN_WORKSPACE_DETACHED

# One check at a time per workspace file: a check already running covers this
# focus too. The lock is a directory holding its owner's pid; a lock whose owner
# is dead was left by a killed check and is taken over.
#
# mkdir and writing the pid are two steps, so a lock with no pid yet is one
# being taken right now, and counts as held. Removing it would let two checks
# run at once.
# TODO(claude): undecided: where the lock lives. Beside the workspace file, as <workspace-file>.lock.
# TODO(claude): undecided: whether a lock with no pid is held or stale. Held, so a check killed between the two steps leaves a lock that must be removed by hand.
LOCK=$WS_FILE.lock
take_lock() {
  mkdir "$LOCK" 2> /dev/null && return 0
  [ -d "$LOCK" ] || { echo "vscode-open-workspace: cannot create $LOCK" >&2; return 1; }
  owner=$(cat "$LOCK/pid" 2> /dev/null)
  [ -n "$owner" ] || return 1
  kill -0 "$owner" 2> /dev/null && return 1
  rm -f "$LOCK/pid"
  rmdir "$LOCK" 2> /dev/null
  mkdir "$LOCK" 2> /dev/null
}
take_lock || exit 0
echo "$$" > "$LOCK/pid"
trap 'rm -f "$LOCK/pid"; rmdir "$LOCK" 2> /dev/null' EXIT
trap 'exit 0' HUP INT TERM

# Every top-level window belonging to a Code process, one title per line.
# VS Code keeps all its windows under one main process, so a process's
# MainWindowTitle (Get-Process, tasklist /v) shows only one of them.
# UIAutomation is loaded rather than Add-Type C# for EnumWindows, which Windows
# PowerShell compiles again in every new process.
# The output has CRLF line ends; the prefix match below is unaffected.
# The name is matched here in sh, so it never has to be quoted for PowerShell.
# shellcheck disable=SC2016 # the $ names are PowerShell's
LIST_TITLES='
$ids = @((Get-Process Code -ErrorAction SilentlyContinue).Id)
if ($ids.Count -eq 0) { exit 0 }
Add-Type -AssemblyName UIAutomationClient
$auto = [System.Windows.Automation.AutomationElement]
$auto::RootElement.FindAll([System.Windows.Automation.TreeScope]::Children, [System.Windows.Automation.Condition]::TrueCondition) |
  Where-Object { $ids -contains $_.Current.ProcessId } |
  ForEach-Object { $_.Current.Name }
'

# A failed check opens the workspace anyway, as the macOS command does.
if TITLES=$(powershell.exe -NoProfile -NonInteractive -Command "$LIST_TITLES"); then
  case "$NL$TITLES" in
    *"$NL$NAME - "*) exit 0 ;;
  esac
else
  echo "vscode-open-workspace: could not list VS Code windows; opening $WS_FILE" >&2
fi

code "$WS_FILE" || echo "vscode-open-workspace: code $WS_FILE failed" >&2
exit 0
