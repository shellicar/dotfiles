#!/bin/sh

# Tags commits made from a Claude Code session with that session's ID, in repos
# whose config sets claude.sessionTrailer = true (e.g. in .gitconfig.d/<org>).
add_session_trailer() {
  [ -n "$CLAUDE_CODE_SESSION_ID" ] || return 0
  [ "$(git config --type=bool claude.sessionTrailer)" = true ] || return 0
  git interpret-trailers --in-place --if-exists doNothing \
    --trailer "Claude-Session: $CLAUDE_CODE_SESSION_ID" "$1"
}

run_local_hook() {
  REPO_HOOK="$(git rev-parse --git-dir)/hooks/commit-msg"
  if [ -x "$REPO_HOOK" ]; then
    exec "$REPO_HOOK" "$@"
  fi
}

add_session_trailer "$1"
run_local_hook "$@"
