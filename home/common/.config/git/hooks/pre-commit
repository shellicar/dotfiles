#!/bin/sh

run_local_hook() {
  # The common dir: a linked worktree's git dir has no hooks/. Not --git-path,
  # which resolves to core.hooksPath, the folder this hook is in.
  REPO_HOOK="$(git rev-parse --git-common-dir)/hooks/pre-commit"
  if [ -x "$REPO_HOOK" ]; then
    exec "$REPO_HOOK" "$@"
  fi
}

run_local_hook "$@"
