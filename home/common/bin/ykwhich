#!/bin/sh
# Name the YubiKey currently plugged in.
#
# All three are physically identical and now hold the same GPG key, so nothing on the
# outside or in a signature tells them apart. The serial does, and it is why the wrong
# one in the port is otherwise invisible.
#
# scdaemon binds to a single card, so more than one present is its own failure and is
# reported as such.
set -e

LIB=$HOME/lib/yubikeys.sh
[ -f "$LIB" ] || LIB=$(cd "$(dirname "$0")/../lib" && pwd)/yubikeys.sh
[ -f "$LIB" ] || { echo "yubikeys.sh not found" >&2; exit 1; }
# shellcheck source=/dev/null
. "$LIB"

serials=$(ykman list --serials 2>/dev/null || true)

if [ -z "$serials" ]; then
  echo "No YubiKey"
  exit 1
fi

status=0

printf '%s\n' "$serials" | while read -r serial; do
  [ -n "$serial" ] || continue
  case "$serial" in
    "$YUBIKEY_A_SERIAL") echo "Key A ($serial)" ;;
    "$YUBIKEY_B_SERIAL") echo "Key B ($serial)" ;;
    "$YUBIKEY_C_SERIAL") echo "Key C ($serial)" ;;
    *)                   echo "Unknown key ($serial)" ;;
  esac
done

count=$(printf '%s\n' "$serials" | grep -c .)
if [ "$count" -gt 1 ]; then
  echo ""
  echo "More than one plugged in; scdaemon binds to one card, so unplug all but one"
  status=1
fi

case "$serials" in
  *"$YUBIKEY_A_SERIAL"*|*"$YUBIKEY_B_SERIAL"*|*"$YUBIKEY_C_SERIAL"*) ;;
  *) status=1 ;;
esac

exit "$status"
