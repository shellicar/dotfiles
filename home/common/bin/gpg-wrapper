#!/bin/sh
# What git calls to sign, in place of gpg itself (`gpg.program` in
# .gitconfig.d/common).
#
# The signing key is on a YubiKey whose touch policy is `cached`, so a signature
# blinks the contact and waits about fifteen seconds for a finger before failing
# with `gpg: signing failed: Timeout`. The blink is easy to miss and nothing
# announces it, so this rings the terminal when a signature is wanted and asks a
# second time when the first went unanswered.
#
# git calls this same program to verify a signature, where nothing is waiting on
# a person, so only the signing call is wrapped. A form of signing call not
# recognised here is handed straight through: that loses the bell, never the
# signature.
#
# The first gpg call consumes stdin, so a second attempt has nothing left to
# sign unless the payload is buffered first. stdout is the signature git reads
# back, so that is buffered too and released only once an attempt succeeds: a
# failed attempt's partial output would otherwise be prepended to a good one.
set -e

signing=no
for arg in "$@"; do
  case "$arg" in
    -bsau) signing=yes ;;
  esac
done

if [ "$signing" = no ]; then
  exec gpg "$@"
fi

attempts=2

bell_state="/tmp/gpg-wrapper-bell.$(id -u)"
bell_quiet=5

payload=$(mktemp)
out=$(mktemp)
err=$(mktemp)

trap 'rm -f "$payload" "$out" "$err"' EXIT

cat >"$payload"

# An unrung bell must never fail a signature, and set -e would make it do that.
set +e

# stdout and stderr are pipes here, so a bell written to either is captured
# rather than heard. A detached spawn has no controlling terminal either, so
# /dev/tty cannot be opened at all. ps reports the terminal per process, and the
# nearest ancestor that still has one is where the person is.
bell_tty() {
  # ps prints ?? for no terminal, which would otherwise glob against the cwd.
  set -f
  pid=$$
  while [ "$pid" -gt 1 ]; do
    # shellcheck disable=SC2046 # splitting ps's two fields is the point
    set -- $(ps -o ppid=,tty= -p "$pid")
    [ "$#" -eq 2 ] || break
    case "$2" in
      \?*) ;;
      *) set +f; printf '/dev/%s\n' "$2"; return 0 ;;
    esac
    pid=$1
  done
  set +f
  return 1
}

ring() {
  now=$(date +%s)
  last=$(cat "$bell_state") || last=0
  [ "$((now - last))" -ge "$bell_quiet" ] || return 0
  printf '%s\n' "$now" >"$bell_state"
  dev=$(bell_tty) && printf '\a' >"$dev"
} 2>/dev/null

attempt=0
status=1

while [ "$attempt" -lt "$attempts" ]; do
  attempt=$((attempt + 1))
  ring
  if gpg "$@" <"$payload" >"$out" 2>"$err"; then
    status=0
    break
  else
    status=$?
  fi
done

cat "$out"
cat "$err" >&2
exit "$status"
