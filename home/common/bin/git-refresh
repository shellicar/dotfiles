#!/bin/sh
#
# git refresh — clean up what has landed, then bring the default branch into
# what is left, in one pass over one snapshot of the repository.
#
#   git refresh          look at everything, then pick what runs
#   git refresh --plan   print the plan and stop, for when there is no terminal
#
#   --base REF           compare against REF instead of the detected trunk
#   --branch BRANCH      look at only this branch, not every local branch;
#                        repeat to name several
#   --depth N            commits to test, down from each tip, for one already
#                        in the trunk (default 50)
#   --no-fetch           skip the initial 'git fetch --prune origin'
#   --old                evaluate branches too far behind to be worth walking
#   -v, --verbose        log progress to stderr
#   -h, --help           show this
#
# WHY IT IS ONE COMMAND. Cleanup and spread have to happen in that order, and
# getting it wrong is not a matter of taste. Spread rebases; rebasing rewrites
# committer dates, so a spread first makes every branch look freshly touched to
# the age signals cleanup reads. It also replays commits onto branches that are
# about to be deleted, conflicting on exactly the ones that were about to go. As
# two commands the order is something you have to remember. As one it cannot be
# expressed wrongly.
#
# THE PLAN DEPENDS ON WHAT YOU PICK, and only in one direction. Cleanup's
# operations depend on nothing. The update operations depend on which removals
# you took, because a worktree that survives the run is a worktree that can be
# updated. So the analysis runs once and the operations are derived again after
# every keystroke. The expensive half — the fetch, the pull request queries,
# the search for each branch's landed commit — is the half that never changes.
#
# A TARGET IS REMOVED OR UPDATED, NEVER BOTH. That is not a policy, it falls out
# of what git allows: a branch with no worktree can only be deleted, a worktree
# with no branch can only be removed, and only a branch with a worktree has two
# possibilities, decided by whether its work has landed.

set -u

DIR=$(cd "$(dirname "$0")" && pwd)
TOOL='git refresh'
# SCRIPTDIR makes shellcheck resolve the path below against this file rather
# than against whatever directory it happens to be run from. A directive applies
# to the command after it, so both must sit against the source line itself.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/git-common.sh
command -v resolve_main >/dev/null 2>&1 || . "$DIR/../lib/git-common.sh"

plan_only=false
NO_FETCH=false
VERBOSE=false
BASE_OVERRIDE=''
EVALUATE_OLD=false
ONLY_BRANCHES=''
WALK_DEPTH=50
MAX_DISTANCE=100; MAX_AGE_DAYS=30
# How long after it was created an empty Claude Code subagent branch has to be
# before its removal starts ticked. A finished subagent can be resumed while its
# session lives, and its worktree is its working folder, so a recent one may
# still be wanted.
AGENT_IDLE_DAYS=7
ADO_RESOURCE=499b84ac-1321-427f-aa17-267ca6975798

# Constants, not state: they belong outside the phases so sourcing this file
# gives a caller the same values the command runs with. NL is a literal newline
# and its closing quote has to stay at column zero.
TAB=$(printf '\t')
NL='
'
E=$(printf '\033')
STRIKE="${E}[9m"; UNSTRIKE="${E}[29m"; INV="${E}[7m"

parse_args() {
  # while/shift, not for-in: three of these take the argument that follows them,
  # which a for loop cannot consume. There is no -b: with --base and --branch in
  # the same command it reads as either.
  while [ $# -gt 0 ]; do
    case "$1" in
      --plan) plan_only=true ;;
      --no-fetch) NO_FETCH=true ;;
      --old) EVALUATE_OLD=true ;;
      --base) shift; [ $# -gt 0 ] || { echo "Error: --base requires a branch name" >&2; exit 2; }; BASE_OVERRIDE=$1 ;;
      --branch) shift; [ $# -gt 0 ] || { echo "Error: --branch requires a branch name" >&2; exit 2; }; ONLY_BRANCHES="$ONLY_BRANCHES $1" ;;
      --depth) shift; [ $# -gt 0 ] || { echo "Error: --depth requires a number" >&2; exit 2; }; WALK_DEPTH=$1 ;;
      -v|--verbose) VERBOSE=true ;;
      -h|--help)
        sed -n '3,37p' "$0" | sed 's/^# \{0,1\}//'
        exit 0 ;;
      *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
    shift
  done

  # No terminal means no selector, so there is nothing to pick from and the plan
  # is the whole of what it can offer.
  [ -t 0 ] || plan_only=true
}

setup() {
  ensure_in_git_repository

  # Run from the main working tree, which git refuses to remove, so this is never
  # standing on what it deletes.
  MAIN_WT=$(git worktree list --porcelain | awk '/^worktree /{print substr($0, 10); exit}')
  [ -n "$MAIN_WT" ] || { echo "Error: cannot find the main working tree" >&2; exit 1; }
  cd "$MAIN_WT" || exit 1

  use_cache_dir
  NOW=$(date +%s)
  resolve_main

  # Named branches are checked before anything slow runs, so a typo fails at
  # once rather than after the fetch and the pull request query.
  for b in $ONLY_BRANCHES; do
    ref_exists "refs/heads/$b" || { echo "Error: no local branch named '$b'" >&2; exit 1; }
  done

  PLAN=''
  REMOVED_COUNT=0
  RESCUED_COUNT=0
}

# ── the analysis, once ──────────────────────────────────────────────────────

analyse() {
say_header

step 'fetch origin ...'
fetch_origin
if [ "$NO_FETCH" = true ]; then step_done 'skipped (--no-fetch)'; else step_done 'done'; fi

step 'merged PRs ...'
fetch_pr_merges
step_done "$(printf '%s' "$PR_MERGE_TABLE" | grep -c .) found ($PR_SOURCE)"
[ -n "$PR_HINT" ] && say "$PR_HINT"

WT_MAP=$(git worktree list --porcelain | awk '
  /^worktree /   { p = substr($0, 10) }
  /^branch refs\/heads\// { print substr($0, 19) "\t" p }
')
DETACHED=$(git worktree list --porcelain | awk '
  /^worktree /   { p = substr($0, 10) }
  /^HEAD /       { h = substr($0, 6) }
  /^detached/    { print h "\t" p }
')

DETACHED_PR_TABLE=''
if [ -n "$DETACHED" ] && [ -z "$ONLY_BRANCHES" ]; then
  step 'detached worktree PRs ...'
  fetch_detached_prs
  step_done "$(printf '%s' "$DETACHED_PR_TABLE" | grep -c .) found"
fi

# EVERYTHING THAT ASKS GIT ANYTHING HAPPENS HERE, once. What is left for derive
# is string work, because derive runs on every keystroke. Getting this wrong is
# not a small cost: a git status per worktree is most of a second on a tree with
# node_modules in it, and there is no budget for that between keypresses.
#
# The only thing derive may not know yet is which branches you have picked to
# remove, so anything that depends on that is left as raw material: the refs
# holding a detached commit are listed here and filtered there.
step 'reading branches and worktrees ...'

# Whether git writes a reflog for a branch here, which is what a missing
# creation date means: the reflog expired, or there never was one. Read once,
# on the assumption that the setting has always been what it is now. git init
# writes true into a repository with a working tree; unset means on except in a
# bare repository.
case $(git config --get core.logAllRefUpdates 2>/dev/null) in
  true|yes|on|1|always) LOGS_REF_UPDATES=yes ;;
  '') LOGS_REF_UPDATES=yes
      [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = true ] && LOGS_REF_UPDATES=no ;;
  *) LOGS_REF_UPDATES=no ;;
esac

# name, worktree, class, ahead, not in main, why, behind, block, update action,
# its detail, ignored, meta, unpushed, stash, other authors, merged pull
# request, commits the rebase replays, merge edits the rebase drops, created
BFACTS=''
# name, worktree, head, in main, merged PR, open PR, closed PR, block, refs,
# ignored, meta
DFACTS=''

for b in ${ONLY_BRANCHES:-$(git for-each-ref --format '%(refname:short)' refs/heads/)}; do
  verdict=$(branch_verdict "$b")
  IFS="$TAB" read -r class n ahead gone pr wt <<EOF
$verdict
EOF
  # The library's sentence, so this says what git cleanup says. It is never
  # empty, which the tab-delimited record below depends on.
  branch_reason "$b" "$class" "$n" "$gone" "$pr"
  why=$REASON

  meta=$(target_meta "$ahead" "$(git rev-list --no-commit-header -1 --format=%cr "refs/heads/$b" 2>/dev/null)")

  # Commits the branch's own remote does not have, which is work that exists
  # nowhere else. Not asked of the trunk: say_environment reports that case in
  # its own words, and says more about it than a count would.
  unpushed=0
  [ "$b" = "$MAIN" ] || unpushed=$(git rev-list --count "$b@{u}..refs/heads/$b" 2>/dev/null || echo 0)

  block='-'; behind=0; uact='-'; udetail='-'; ign='-'; stash=no; owner=-; replays=-; drops=-
  if [ -n "$wt" ]; then
    ign=$(worktree_ignored "$wt"); ign=${ign:--}
    b_reason=$(worktree_block_reason "$wt")
    [ -n "$b_reason" ] && block=$b_reason
    behind=$(git -C "$wt" rev-list --count "HEAD..$MAIN_REF" 2>/dev/null || echo 0)
    # No update for a branch whose work is already in the trunk. There is
    # nothing to bring in, and replaying its commits onto a trunk that already
    # has their content duplicates them and pushes them to a branch the merge
    # deleted.
    #
    # Nor for a review branch with a merged pull request of its own: the
    # commits above its landed commit were added after that merge, and the
    # rescue is what carries them forward. A review branch without one is
    # rebased from its landed commit, which replays only the commits above it
    # and keeps the branch and its worktree.
    #
    # A dirty worktree is not excluded here. It blocks a removal absolutely,
    # because that destroys work. An update only has to get past git, which
    # refuses far less than a dirty tree suggests, and update_needs_stash is
    # what decides which.
    #
    # Nor is a locked one. git refuses to remove, move or prune a locked
    # worktree and nothing else, so the lock is in block and stops the removal
    # row only.
    if [ "$behind" != 0 ] && [ "$class" != merged ] &&
       { [ "$class" != review ] || [ "$pr" = no ]; }; then
      # Asked before the strategy, because the strategy is a rebase and a rebase
      # here force-pushes. git spread stops for this and so does git catchup.
      if branch_diverged_from_remote "$wt" "$b"; then
        uact=none; udetail='diverged from its own remote, resolve that first'
      else
        # Computed before the read: a here-doc is expanded as part of setting
        # up the command it feeds, so the substitution would run with IFS
        # already set to tab.
        # rebase: a branch that has merged the trunk is rebased like any other
        # here, and what the rebase would drop of its merges is named below.
        uv=$(owned_update_verdict "$wt" "$b" rebase)
        IFS="$TAB" read -r uact udetail owner <<EOF
$uv
EOF
        if [ "$uact" != none ] && update_needs_stash "$wt" "$uact"; then stash=yes; fi
        if [ "$uact" = rebase ]; then
          replays=$(rebase_count "$udetail" "$b")
          # The library gives one line per merge; the record needs one field.
          drops=$(merge_edits "$udetail" "$b" |
            awk -F'\t' '{ printf "%s%s made to %s", (NR > 1 ? "; " : ""), $1, $2 }')
          drops=${drops:--}
        fi
      fi
    fi
  fi

  # When the branch was created, as epoch seconds, read from the reflog's oldest
  # entry. Not the tip's date: an empty branch's tip is a commit of main, which
  # can be far older than the branch. %gd with --date=unix prints the entry's
  # own time as name@{seconds}; %ct would print the commit's. reflog is git log
  # underneath, so --no-show-signature keeps log.showSignature from running gpg
  # on every entry and printing its lines among them. Only asked where derive
  # reads it, an empty Claude Code subagent branch.
  # TODO(claude): undecided: whether the reflog is read for every branch or only
  # for the ones derive uses it on. Only those for now.
  #
  # Three outcomes, kept apart: the seconds, when the oldest line reads
  # name@{seconds}; none, when the read succeeded and printed nothing, which is
  # a branch with no reflog; and -, unknown, when the read failed or printed
  # something else.
  created=-
  case "$class:$b" in
    empty:worktree-agent-*)
      if entries=$(git reflog --no-show-signature --date=unix --format=%gd "refs/heads/$b" 2>/dev/null); then
        if [ -z "$entries" ]; then
          created=none
        else
          oldest=$(printf '%s\n' "$entries" | tail -1)
          case "$oldest" in
            *@\{*\})
              created=${oldest##*@\{}; created=${created%\}}
              case "$created" in ''|*[!0-9]*) created=- ;; esac ;;
          esac
        fi
      fi
      ;;
  esac
  BFACTS="$BFACTS$b$TAB${wt:--}$TAB$class$TAB$ahead$TAB$n$TAB$why$TAB$behind$TAB$block$TAB$uact$TAB$udetail$TAB$ign$TAB$meta$TAB$unpushed$TAB$stash$TAB$owner$TAB$pr$TAB$replays$TAB$drops$TAB$created$NL"
done

# With --branch the run is about the branches you named, so a worktree with no
# branch on it is not part of it.
DETACHED_TARGETS=$DETACHED
[ -n "$ONLY_BRANCHES" ] && DETACHED_TARGETS=''

while IFS="$TAB" read -r head p; do
  [ -z "$head" ] && continue
  inmain=no
  [ "$(commits_not_in_main "$head")" = 0 ] && inmain=yes
  mpr=$(detached_pr "$head" merged)
  opr=$(detached_pr "$head" open)
  cpr=$(detached_pr "$head" closed)
  b_reason=$(worktree_block_reason "$p")
  refs=$(refs_containing "$head")
  ign=$(worktree_ignored "$p")
  meta=$(target_meta "$(git rev-list --count "$MAIN_REF..$head" 2>/dev/null || echo '?')" \
    "$(git rev-list --no-commit-header -1 --format=%cr "$head" 2>/dev/null)" "$(git rev-parse --short "$head" 2>/dev/null)")
  DFACTS="$DFACTS$(basename "$p")$TAB$p$TAB$head$TAB$inmain$TAB${mpr:--}$TAB${opr:--}$TAB${cpr:--}$TAB${b_reason:--}$TAB${refs:--}$TAB${ign:--}$TAB$meta$NL"
done <<EOF
$DETACHED_TARGETS
EOF
step_done "$(printf '%s%s' "$BFACTS" "$DFACTS" | grep -c .) targets"
}

# ── deriving the operations, after every keystroke ──────────────────────────

SELECTED=' '
SEEN=' '
BLOCKED=' '
ROWS=''
COUNT=0
PICKED=0
CUR=1
TOP=1
IC='  '

select_op() { has "$1" "$SELECTED" || SELECTED="$SELECTED$1 "; return 0; }
# Parameter expansion, not sed: nearly every branch name has a slash in it and
# sed would read it as the end of the pattern.
deselect_op() {
  case "$SELECTED" in
    *" $1 "*) SELECTED="${SELECTED%%" $1 "*} ${SELECTED#*" $1 "}" ;;
  esac
  return 0
}
mark_seen() { has "$1" "$SEEN" || SEEN="$SEEN$1 "; return 0; }
block_op() { has "$1" "$BLOCKED" || BLOCKED="$BLOCKED$1 "; return 0; }

# First sight applies the default; after that the choice is yours, and an
# operation that becomes unavailable is masked rather than deselected so it
# comes back the way you left it.
note_default() {
  has "$1" "$SEEN" && return 0
  mark_seen "$1"
  [ "$2" = on ] && select_op "$1"
  return 0
}

icon_of() {
  case "$1" in
    remove|detach) IC='🔥' ;;
    rescue) IC='🛟' ;;
    ff)     IC='⏩' ;;
    merge)  IC='🔀' ;;
    rebase) IC='🔁' ;;
    *)      IC='  ' ;;
  esac
}

# An absent worktree is written as '-', never as nothing. Tab is IFS
# whitespace, so a run of tabs is one delimiter: an empty field does not survive
# being read back, it disappears and drags every later field one place left.
# plan_add has carried this rule since it was written; this is the same rule.
emit() {
  ROWS="$ROWS$1$TAB$2$TAB$3$TAB$4$TAB${5:--}$TAB$6$TAB${7:--}$TAB${8:--}$TAB${9:--}$TAB${10:--}$TAB${11:-no}$NL"
  # COUNT is every row, because it bounds the cursor and the scroll window. It
  # counts rows nobody can tick, so it is not a count of what is on offer.
  COUNT=$((COUNT + 1))
  [ "$2" = on ] && PICKED=$((PICKED + 1))
  return 0
}

# Rows: id, state, kind, action, target, why, ignored, count, class. Forks
# nothing, because this runs again on every keystroke. Branches first, so that
# by the time a detached worktree is judged, every removal that could orphan
# its commit is counted.
derive() {
  ROWS=''
  COUNT=0
  PICKED=0
  BLOCKED=' '
  NOTED=''
  DOOMED=' '

  while IFS="$TAB" read -r name wt class ahead n why behind block uact udetail ign meta unpushed stash owner pr replays drops created; do
    [ -z "$name" ] && continue
    [ "$wt" = - ] && wt=''
    # A record that stops short of the last four fields has none of them.
    pr=${pr:-no}; replays=${replays:--}; drops=${drops:--}; created=${created:--}

    # The trunk is here for its update and nothing else. Left to the verdict it
    # reads as "empty", being an ancestor of itself with nothing ahead, and would
    # be offered for deletion.
    removal=''
    # Reset every iteration: below, a branch with no removal reads it, and a
    # value left over from the previous branch would answer for it.
    def=off
    # empty is unticked here, the way git cleanup holds it behind --empty. The
    # default is what decides, because pressing r on arrival is the ordinary way
    # to run this: a class the other command makes you ask for cannot be ticked
    # already in this one. There is one exception, below, for old Claude Code
    # subagent branches.
    [ "$name" = "$MAIN" ] || case "$class" in
      merged)  removal="remove $name"; def=on ;;
      empty)   removal="remove $name"; def=off ;;
      suspect) removal="remove $name"; def=off ;;
    esac
    # A rescue only when a pull request of this branch's own has merged. Without
    # one the branch is offered its rebase below instead, and kept.
    [ "$name" != "$MAIN" ] && [ "$class" = review ] && [ "$pr" = yes ] &&
      { removal="rescue $n off $name, then remove it"; def=off; }
    # The exception. An empty branch named
    # worktree-agent-*, which only Claude Code makes, for a subagent, starts
    # ticked once it was created AGENT_IDLE_DAYS or more ago and its worktree, if
    # it has one, holds no ignored files for the removal to take silently. A
    # branch with no reflog counts as old where git logs ref updates, since the
    # reflog has then expired (git gc drops entries after 90 days by default),
    # and as unknown, so not old, where it does not. A reflog that could not be
    # read or did not parse is unknown too. A dirty or locked worktree is still
    # blocked below, whatever this decides.
    #
    # Only the removal's default changes. def is still the class's default and
    # the update below still reads it, so unticking this removal does not tick
    # the update that comes back in its place.
    rdef=$def
    rwhy=$why
    agent=no
    case "$name" in worktree-agent-*) agent=yes ;; esac
    old=no
    age="created ${AGENT_IDLE_DAYS}+ days ago"
    case "$created" in
      none)
        [ "${LOGS_REF_UPDATES:-no}" = yes ] && { old=yes; age='with an expired reflog'; } ;;
      ''|*[!0-9]*) ;;
      *) [ $((NOW - created)) -ge $((AGENT_IDLE_DAYS * 86400)) ] && old=yes ;;
    esac
    if [ "$class" = empty ] && [ "$name" != "$MAIN" ] && [ "$agent" = yes ] &&
       [ "$ign" = - ] && [ "$old" = yes ]; then
      rdef=on
      rwhy="$why, agent branch $age"
    fi
    # What the class offers, kept because the update's default follows it even
    # when the removal cannot run.
    offered=$removal
    if [ -n "$removal" ]; then
      [ -n "$wt" ] && removal="$removal and its worktree"
      [ "$class" = review ] && k=rescue || k=remove
      if [ "$block" != - ]; then
        # Decided and unavailable. The update row below is unticked because of
        # this decision and its arrow points here, so this row is what explains
        # it. Both halves are on the line: what the branch is, and what is
        # stopping it.
        block_op "${name}R"
        emit "${name}R" skip "$k" "$removal" "$wt" "$why, $block" "$ign" "$n" "$class" "$meta"
      else
        note_default "${name}R" "$rdef"
        st=off; has "${name}R" "$SELECTED" && st=on
        [ "$st" = on ] && doom_branch "$name"
        emit "${name}R" "$st" "$k" "$removal" "$wt" "$rwhy" "$ign" "$n" "$class" "$meta"
      fi
    fi

    # Everything with no operation on it is said. git cleanup holds the same
    # branches behind -a because there they sit in the middle of its one list,
    # among the branches it is offering to act on. Here they are a section of
    # their own below the plan, so they crowd nothing out.
    #
    # The block is said here only when the branch has no row at all. A blocked
    # removal is a [-] row that says so itself, and an update on a dirty
    # worktree names its own stash, so repeating it beside either would claim
    # something was refused when nothing was.
    saying_block=no
    [ "$block" != - ] && [ -z "$offered" ] && [ "$uact" = - ] && saying_block=yes
    if [ "$saying_block" = yes ]; then
      NOTED="$NOTED$name${TAB}blocked$TAB$meta$TAB$block$NL"
    elif [ "$class" = inconclusive ]; then
      NOTED="$NOTED$name$TAB$class$TAB$meta$TAB$why, run --old$NL"
    elif [ "$class" = unchecked ] && [ -z "$removal" ] && [ "$uact" = - ]; then
      NOTED="$NOTED$name$TAB$class$TAB$meta$TAB$why, run --depth$NL"
    elif [ -z "$removal" ] && [ "$uact" = - ] && [ "$unpushed" != 0 ]; then
      # Work on no remote is the one thing in this list you can actually lose,
      # so it displaces the plainer reason below.
      NOTED="$NOTED$name$TAB$class$TAB$meta$TAB$unpushed not pushed$NL"
    elif [ -z "$removal" ] && [ "$uact" = - ]; then
      # Two things reach here. The trunk, which is excluded from removal above,
      # and whose reason is written about a branch and says nothing about it.
      # And a branch with no operation of any kind, which is most of what this
      # section is for. Every other class has an operation and is shown as one.
      note=$why; ncls=$class
      [ "$name" = "$MAIN" ] && { note='the trunk'; ncls=-; }
      NOTED="$NOTED$name$TAB$ncls$TAB$meta$TAB$note$NL"
    fi

    [ "$uact" = - ] && continue
    if [ "$uact" = none ]; then NOTED="$NOTED$name$TAB$class$TAB$meta$TAB$udetail$NL"; continue; fi
    case "$uact" in
      ff)     act="fast-forward $name" ;;
      merge)  act="merge $MAIN into $name" ;;
      *)      act="rebase $name onto $MAIN" ;;
    esac
    # Named in the action, because setting your working tree aside and putting
    # it back is part of what the row does, not a detail of how.
    [ "$stash" = yes ] && act="stash, $act, restore"
    # Marked as belonging to the row above only when that row is actually there.
    # A class with no removal on offer has none, and an arrow there would point
    # at nothing.
    ucls=-
    [ -n "$removal" ] && ucls=related
    if [ -n "$removal" ] && has "${name}R" "$SELECTED"; then
      block_op "${name}U"
      emit "${name}U" skip "$uact" "$act" "$wt" "skipped, the removal above takes it" - - "$ucls" "$meta" "$stash"
    else
      # The update starts where the class starts the removal. A branch the
      # command is offering to delete is not one it also proposes to maintain,
      # whether or not you take the removal. That is def, not rdef: an agent
      # branch whose removal starts ticked still gets an update that starts off.
      #
      # And an update that has to move your uncommitted work out of the way
      # starts off whatever else is true, which is git spread's default.
      udef=on
      [ -n "$offered" ] && udef=$def
      [ "$stash" = yes ] && udef=off
      uwhy="$behind behind"
      case "$replays" in
        -) ;;
        1) uwhy="$uwhy, 1 commit to replay" ;;
        *) uwhy="$uwhy, $replays commits to replay" ;;
      esac
      [ "$owner" != - ] && { udef=off; uwhy="$uwhy, not yours: $owner"; }
      # A merge with edits of its own is dropped by the rebase, and those edits
      # with it. Offered all the same, but unticked, with the merge and its
      # files named.
      [ "$drops" != - ] && { udef=off; uwhy="$uwhy, rebasing drops the edits merge $drops"; }
      note_default "${name}U" "$udef"
      st=off; has "${name}U" "$SELECTED" && st=on
      emit "${name}U" "$st" "$uact" "$act" "$wt" "$uwhy" - - "$ucls" "$meta" "$stash"
    fi
  done <<EOF
$BFACTS
EOF

  while IFS="$TAB" read -r name wt head inmain mpr opr cpr block refs ign meta; do
    [ -z "$name" ] && continue
    if [ "$block" != - ]; then NOTED="$NOTED$name${TAB}blocked$TAB$meta$TAB$block$NL"; continue; fi

    if [ "$inmain" = yes ]; then
      dcls=landed; detached_reason inmain
    elif [ "$mpr" != - ]; then
      dcls=landed; detached_reason merged "$mpr"
    else
      # The one selection-dependent question: a branch you are removing is not a
      # home for anything, so it does not count as holding this commit.
      held=''
      if [ "$refs" != - ]; then
        oifs=$IFS; IFS=' '
        for r in $refs; do
          doomed_branch "$r" && continue
          held=$r
          break
        done
        IFS=$oifs
      fi
      if [ -n "$held" ]; then detached_reason onref "$held"; NOTED="$NOTED$name${TAB}live$TAB$meta$TAB$REASON$NL"; continue; fi
      if [ "$opr" != - ]; then detached_reason open "$opr"; NOTED="$NOTED$name${TAB}live$TAB$meta$TAB$REASON$NL"; continue; fi
      dcls=unsure
      if [ "$cpr" != - ]; then detached_reason closed "$cpr"; else detached_reason orphan; fi
    fi

    # Kind 'detach', not 'remove': the plan routes on it, and a worktree with no
    # branch loses only the directory. Inferring that later from whether the name
    # matched the directory's basename removed the worktree and left the branch.
    #
    # Unticked whichever class it is, because git cleanup holds a detached
    # removal behind --detached and the two defaults have to agree.
    note_default "${name}D" off
    st=off; has "${name}D" "$SELECTED" && st=on
    emit "${name}D" "$st" detach "remove worktree $name" "$wt" "$REASON" "$ign" - "$dcls" "$meta"
  done <<EOF
$DFACTS
EOF
}

# ── the screen ──────────────────────────────────────────────────────────────

draw() {
  size=$(stty size 2>/dev/null) || size='24 80'
  height=${size%% *}
  width=${size##* }
  case "$height" in ''|*[!0-9]*) height=24 ;; esac
  case "$width" in ''|*[!0-9]*) width=80 ;; esac
  # The frame never runs past the bottom of the pane, or the terminal scrolls
  # and takes the header and the cursor row off the top. The header and the
  # footer take four lines and one is spare, so the rows and the section share
  # the rest. The rows come first: they are what you act on.
  budget=$((height - 5))
  avail=$COUNT
  [ "$avail" -gt "$budget" ] && avail=$budget
  # A pane under six lines is too short for the header, one row and the
  # footer. One row is drawn anyway, so there the frame is taller than the pane.
  [ "$avail" -lt 1 ] && avail=1
  # The section gets what is left, and say_noted cuts itself to fit.
  room=$((budget - avail))
  text=$((width - 10))
  [ "$text" -lt 20 ] && text=20

  [ "$CUR" -lt "$TOP" ] && TOP=$CUR
  [ "$CUR" -ge $((TOP + avail)) ] && TOP=$((CUR - avail + 1))
  [ "$TOP" -lt 1 ] && TOP=1

  printf '%b[?2026h%b[H%b[2J' "$E" "$E" "$E"
  printf '%b%s%b  %b[x] runs, [ ] does not, [-] unavailable%b\n' \
    "$BOLD" "$MAIN" "$RESET" "$DIM" "$RESET"

  i=0
  while IFS="$TAB" read -r op state kind action target why ign n class meta stash; do
    [ -z "$op" ] && continue
    i=$((i + 1))
    [ "$i" -lt "$TOP" ] && continue
    [ "$i" -ge $((TOP + avail)) ] && continue
    if [ "$i" -eq "$CUR" ]; then point="$INV>$RESET"; else point=' '; fi
    [ "$why" = - ] && why=''
    body="$action  $why"
    if [ "$state" = on ]; then icon_of "$kind"; else IC='• '; fi
    # The class icon carries its own reset, so the dim of an unselected row is
    # reopened after it.
    class_icon "$class"
    case "$state" in
      on)   printf ' %b %b[x]%b %b %s %.*s %b\n' "$point" "$GREEN" "$RESET" "$CICON" "$IC" "$text" "$body" "$meta" ;;
      off)  printf ' %b %b[ ] %b%b %s %.*s %b%b\n' "$point" "$DIM" "$CICON" "$DIM" "$IC" "$text" "$body" "$meta" "$RESET" ;;
      skip) printf ' %b %b[-] %b%b %s %b%.*s%b %b\n' "$point" "$DIM" "$CICON" "$DIM" "$IC" "$STRIKE" "$text" "$body" "$UNSTRIKE$RESET" "$meta" ;;
    esac
  done <<EOF
$ROWS
EOF

  # What was looked at and has no valid action, which nothing on the list says
  # otherwise. Not part of the list, so the cursor never reaches it.
  say_noted "$room"

  last=$((TOP + avail - 1))
  [ "$last" -gt "$COUNT" ] && last=$COUNT
  printf '\n%b%s selected   showing %s-%s of %s%b\n' \
    "$DIM" "$PICKED" "$TOP" "$last" "$COUNT" "$RESET"
  printf '%bup/down move, space toggles, r runs, q quits. enter does nothing.%b' "$DIM" "$RESET"
  printf '%b[?2026l' "$E"
}

toggle_current() {
  op=$(printf '%s' "$ROWS" | awk -F"$TAB" -v k="$CUR" 'NR==k{print $1; exit}')
  [ -z "$op" ] && return 0
  has "$op" "$BLOCKED" && return 0
  if has "$op" "$SELECTED"; then deselect_op "$op"; else select_op "$op"; fi
  return 0
}

readkey() {
  k=$(dd bs=1 count=1 2>/dev/null)
  if [ "$k" = "$E" ]; then
    k=$(dd bs=1 count=1 2>/dev/null)
    [ "$k" = '[' ] || { KEY=other; return 0; }
    k=$(dd bs=1 count=1 2>/dev/null)
    case "$k" in A) KEY=up ;; B) KEY=down ;; *) KEY=other ;; esac
    return 0
  fi
  # Nothing read is the read timing out, which the picker's terminal settings
  # make it do several times a second so a resize is noticed between keys.
  # Enter reads as nothing too, since $() drops the newline, and it does
  # nothing either way.
  case "$k" in
    '')  KEY=none ;;
    ' ') KEY=space ;;
    q|Q) KEY=quit ;;
    r|R) KEY=run ;;
    j|J) KEY=down ;;
    k|K) KEY=up ;;
    *)   KEY=other ;;
  esac
  return 0
}

# Draws, reads a key, acts on it, and draws again, until you run or quit.
# Leaves VERDICT set to run or quit.
#
# A resize redraws at the new size without waiting for a key. The trap only
# notes it: a trap runs once the command the shell is waiting on returns, and
# dd ignores the signal, so readkey's read is what has to come back. It does,
# because the picker's terminal settings make a read with nothing to read time
# out (stty min 0 time 2). A timeout with no resize redraws nothing.
picker_loop() {
  RESIZED=no
  trap 'RESIZED=yes' WINCH
  VERDICT=quit
  while :; do
    derive
    [ "$CUR" -gt "$COUNT" ] && CUR=$COUNT
    [ "$CUR" -lt 1 ] && CUR=1
    RESIZED=no
    draw
    while :; do
      readkey
      [ "$KEY" = none ] && [ "$RESIZED" = no ] && continue
      break
    done
    case "$KEY" in
      up)    [ "$CUR" -gt 1 ] && CUR=$((CUR - 1)) ;;
      down)  [ "$CUR" -lt "$COUNT" ] && CUR=$((CUR + 1)) ;;
      space) toggle_current ;;
      run)   VERDICT=run; break ;;
      quit)  VERDICT=quit; break ;;
    esac
  done
  trap - WINCH
}

# What is selected, in the order it will happen. Printed before the countdown as
# well as by --plan: leaving the alternate screen takes the list with it, and
# being asked to confirm something you can no longer see is not being asked.
#
# With 'all' every row is printed and marked instead, which is what --plan
# needs. Most operations start unticked, so printing the ticked ones alone
# understates what is on offer. The selector cannot mislead that way, because
# the rest of the list is on screen beside them.
say_selected() {
  if [ "${2:-}" = all ]; then
    printf '\n%b%s%b  %b[x] runs, [ ] does not, [-] unavailable%b\n' \
      "$BOLD" "$1" "$RESET" "$DIM" "$RESET"
  else
    printf '\n%b%s%b\n' "$BOLD" "$1" "$RESET"
  fi
  while IFS="$TAB" read -r op state kind action target why ign n class meta stash; do
    [ -z "$op" ] && continue
    if [ "${2:-}" = all ]; then
      case "$state" in
        on)  mark="${GREEN}[x]${RESET} " ;;
        off) mark="${DIM}[ ]${RESET} " ;;
        *)   mark="${DIM}[-]${RESET} " ;;
      esac
    else
      [ "$state" = on ] || continue
      mark=''
    fi
    [ "$why" = - ] && why=''
    icon_of "$kind"
    class_icon "$class"
    printf '  %b%b %s %s %b  %b%s%b\n' "$mark" "$CICON" "$IC" "$action" "$meta" "$DIM" "$why" "$RESET"
    # Only for something that is actually going to happen. On an unticked row it
    # warns about a deletion nobody has asked for yet.
    [ "$state" = on ] && [ "$ign" != - ] && say_ignored "$ign"
  done <<EOF
$ROWS
EOF
}

# With a number, the section takes at most that many lines, its blank line and
# heading included. Entries that do not fit are counted on a last line instead,
# since the full section is printed again to the normal screen.
say_noted() {
  [ -z "$NOTED" ] && return 0
  lines=${1:-}; total=0; shown=0
  while IFS="$TAB" read -r nm _; do
    [ -n "$nm" ] && total=$((total + 1))
  done <<EOF
$NOTED
EOF
  fit=$total
  if [ -n "$lines" ] && [ $((total + 2)) -gt "$lines" ]; then
    # Too little room for the blank line, the heading and the count, so the
    # section is left out. It is still printed to the normal screen.
    [ "$lines" -lt 3 ] && return 0
    fit=$((lines - 3))
  fi
  printf '\n%bLooked at, no valid action%b\n' "$BOLD" "$RESET"
  while IFS="$TAB" read -r nm cls mt w; do
    [ -z "$nm" ] && continue
    [ "$shown" -ge "$fit" ] && break
    shown=$((shown + 1))
    class_icon "$cls"
    printf '  %b %b%s%b %b  %b%s%b\n' "$CICON" "$DIM" "$nm" "$RESET" "$mt" "$DIM" "$w" "$RESET"
  done <<EOF
$NOTED
EOF
  [ "$shown" -lt "$total" ] &&
    printf '  %b+%s more, shown after you quit%b\n' "$DIM" "$((total - shown))" "$RESET"
  return 0
}

# ── picking, then doing ─────────────────────────────────────────────────────

# What was picked, as a plan, in the order the rows were derived, which puts
# every removal before the update of anything that survives it.
#
# A function rather than a loop inside main, so that a test can call it. The
# rescue replays from the branch's landed commit, asked for again here by the
# same function the verdict used, not counted back from the tip by the row's
# number: on a branch with a merge in it, the nth commit down need not be the
# landed commit. Get the commit wrong and it replays from there, then deletes
# the original, which is the only place in these commands where work goes
# without anything saying so.
build_plan() {
  while IFS="$TAB" read -r op state kind action target why ign n class meta stash; do
    [ -z "$op" ] && continue
    [ "$state" = on ] || continue
    # The icon the row showed, so each result line names its action the same way.
    icon_of "$kind"
    case "$kind" in
      remove)
        plan_add delete "${op%R}" - - "${target:--}" "$IC"
        ;;
      detach)
        plan_add detached "${op%D}" - - "$target" "$IC"
        ;;
      rescue)
        b=${op%R}
        join=$(landed_sha "$(landed_commit "refs/heads/$b")")
        [ -n "$join" ] || { say "  ${YELLOW}${WARN}${RESET}$IC $b: no landed commit found, rescue skipped"; continue; }
        plan_add rescue "$b" "$join" "$n" "${target:--}" "$IC"
        ;;
      ff|merge|rebase)
        b=${op%U}
        plan_add "$kind" "$b" "$stash" - "$target" "$IC"
        ;;
    esac
  done <<EOF
$ROWS
EOF
}

main() {
parse_args "$@"
setup
analyse
derive

# Nothing on offer means there is nothing to pick from, and a selector with no
# rows is a blank screen you cannot act on or learn anything from. Say what was
# looked at and stop.
if [ "$COUNT" -eq 0 ]; then
  say_environment
  say_noted
  printf '\n%bnothing to do%b\n' "$DIM" "$RESET"
  exit 0
fi

if [ "$plan_only" = true ]; then
  say_environment
  say_selected 'Plan' all
  say_noted
  printf '\n%bplan only, nothing was touched%b\n' "$DIM" "$RESET"
  exit 0
fi

# Printed into the primary buffer before the alternate screen opens, so it is
# waiting when you come back however you left. Ctrl-c is the one that decides
# this: it exits on its signal and never reaches the code below the loop.
#
# It is also the state you are picking from, which is the point of it. The list
# can shift as you tick, since a detached worktree stops being held by a branch
# you are deleting, and the selector shows that as it happens.
say_environment
say_noted

SAVED=$(stty -g)
restore() { stty "$SAVED" 2>/dev/null; printf '%b[?2026l%b[?7h%b[?25h%b[?1049l' "$E" "$E" "$E" "$E"; }
# Every signal that would otherwise kill this, because a process killed by one
# never reaches the shell's exit path and so never runs the EXIT trap. What is
# left behind is a terminal still in raw mode with the alternate screen up: no
# echo and no line editing. QUIT is the reachable one, since stty -icanon -echo
# leaves ISIG on and ctrl-\ still fires from inside the selector.
#
# Each exits as well as restoring. Restoring alone lets the loop carry on
# against a terminal that is no longer in raw mode.
trap 'restore; exit 129' HUP
trap 'restore; exit 130' INT
trap 'restore; exit 131' QUIT
trap 'restore; exit 143' TERM
trap 'restore' EXIT

# min 0 time 2: a read with nothing to read gives up after 0.2s, so picker_loop
# can notice a resize between keys.
stty -icanon -echo min 0 time 2
# Line wrap off while the picker is up, so a line wider than the terminal is cut
# at the edge instead of taking a second row. draw counts one row per line of
# the section below the list, which say_noted does not cut to the width.
# restore turns line wrap back on.
printf '%b[?1049h%b[?25l%b[?7l' "$E" "$E" "$E"

picker_loop

restore
trap - EXIT HUP INT QUIT TERM

[ "$VERDICT" = quit ] && { printf 'nothing done\n'; exit 0; }

build_plan

[ -z "$PLAN" ] && { printf 'nothing selected\n'; exit 0; }

say_selected 'Will run'
printf '\n%bstarting in 5 seconds, ctrl-c to abort%b\n\n' "$BOLD" "$RESET"
sleep 5
run_plan
printf '\n%bremoved %s, rescued %s this run%b\n' "$DIM" "$REMOVED_COUNT" "$RESCUED_COUNT" "$RESET"

}

# Sourcing this file defines its functions and runs nothing, so a test can call
# any one of them with data of its own. Only running it as the command executes.
case "${0##*/}" in
  git-refresh) main "$@" ;;
esac