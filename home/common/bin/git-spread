#!/bin/sh
# Spread origin/main into every worktree of the current repo.
# Dry run by default; --apply to act; --stash to stash dirty trees first.
#   git spread                 print the plan, touch nothing
#   git spread --apply         print the plan, pause 5 seconds, then carry it out
#   git spread --stash         dry run, counting dirty trees as stashable
#   git spread --stash --apply as --apply, stashing dirty trees first
# Per worktree: main fast-forwards only; a branch that has already merged
# origin/main merges it again; every other branch rebases onto origin/main.
# The strategy follows the branch's own history, because rebasing a branch that
# merged main would flatten that merge and discard whatever was resolved in it.
# A conflicted rebase or merge is aborted and reported, never left half-done.
# Upstreams: a branch that has genuinely diverged from its own remote is
# skipped (resolve the branch's own story first). A branch whose upstream
# was an ancestor is rebased and then pushed --force-with-lease — safe here
# because the lease reflects the fetch this same run just did. A branch that
# merges rewrites nothing, so its push is an ordinary fast-forward, no lease.

apply=0
stash=0
for arg in "$@"; do
  case "$arg" in
    --apply) apply=1 ;;
    --stash) stash=1 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

TAB=$(printf '\t')
PLAN=''

# One planned action per line. Fields are tab separated and none can be empty,
# and the worktree path goes last so it absorbs anything unusual in the path.
plan_add() {
  PLAN="${PLAN}$1${TAB}$2${TAB}$3${TAB}$4${TAB}$5
"
}

git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo" >&2; exit 2; }

echo "fetching origin (prune)..."
git fetch --quiet --prune origin || { echo "❌ fetch failed" >&2; exit 1; }
target=$(git rev-parse --verify --quiet origin/main) || { echo "❌ no origin/main" >&2; exit 1; }

# Has this branch already merged origin/main into itself? Then it keeps merging:
# a rebase would flatten that merge away and discard whatever was resolved in it.
# The test is the merge commits' parents past the first, not the merge commits
# themselves. 'git pull' without --rebase also writes a merge commit, but of the
# branch's own remote, which is not main and is no reason to stop rebasing.
has_merged_main() (
  parents=$(git -C "$1" rev-list --merges --parents "$target..HEAD" | awk '{ for (i = 3; i <= NF; i++) print $i }')
  while IFS= read -r parent; do
    [ -n "$parent" ] || continue
    if git -C "$1" merge-base --is-ancestor "$parent" "$target"; then
      return 0
    fi
  done <<EOF
$parents
EOF
  return 1
)

# Fed by here-doc, not by a pipe: a while loop downstream of a pipe runs in a
# subshell, and the plan it built would be discarded at 'done'.
WORKTREES=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}')

while IFS= read -r wt; do
  [ -z "$wt" ] && continue
  branch=$(git -C "$wt" symbolic-ref --quiet --short HEAD)
  if [ -z "$branch" ]; then
    printf '⚠️  %s: detached HEAD — skipping\n' "$wt"
    continue
  fi

  dirty=$(git -C "$wt" status --porcelain)
  behind=$(git -C "$wt" rev-list --count "HEAD..$target")
  ahead=$(git -C "$wt" rev-list --count "$target..HEAD")

  upstream=$(git -C "$wt" rev-parse --verify --quiet '@{u}')
  # Upstream configured but the remote-tracking ref pruned away: the remote
  # branch was deleted (merged PR). Not ours to rebase - it's a cleanup
  # candidate.
  if [ -z "$upstream" ] && [ -n "$(git -C "$wt" config "branch.$branch.merge")" ]; then
    printf '🧹 %s [%s]: upstream gone (merged and deleted?) — skipping, cleanup candidate\n' "$wt" "$branch"
    continue
  fi
  push_after=0
  if [ -n "$upstream" ] && [ "$branch" != "main" ]; then
    if git -C "$wt" merge-base --is-ancestor "$upstream" HEAD; then
      push_after=1
    else
      printf '⛔ %s [%s]: diverged from its own remote — resolve that first, skipping\n' "$wt" "$branch"
      continue
    fi
  fi

  if [ "$behind" -eq 0 ]; then
    printf '✅ %s [%s]: up to date with origin/main\n' "$wt" "$branch"
    continue
  fi

  if [ -n "$dirty" ] && [ "$stash" -eq 0 ]; then
    printf '⚠️  %s [%s]: dirty — skipping (use --stash)\n' "$wt" "$branch"
    continue
  fi

  # All three icons are double-width with no variation selector, so they take one
  # trailing space and line up with ✅. The ⚠️ used elsewhere is a narrow base
  # character wearing FE0F, which is why that one is written with two.
  verb="rebase onto"; action=rebase; icon='🔁'
  if [ "$branch" = "main" ]; then
    verb="fast-forward to"; action=ff; icon='⏩'
  elif has_merged_main "$wt"; then
    verb="merge"; action=merge; icon='🔀'
  fi

  stash_first=0
  [ -n "$dirty" ] && stash_first=1

  extra=""
  [ "$stash_first" -eq 1 ] && extra=" (stash first)"
  if [ "$push_after" -eq 1 ]; then
    if [ "$action" = merge ]; then
      extra="$extra + push"
    else
      extra="$extra + force-push (with lease)"
    fi
  fi

  word=would
  [ "$apply" -eq 1 ] && word=will
  printf '%s %s [%s]: %s %s origin/main (behind %s, ahead %s)%s\n' \
    "$icon" "$wt" "$branch" "$word" "$verb" "$behind" "$ahead" "$extra"

  [ "$apply" -eq 1 ] && plan_add "$action" "$branch" "$stash_first" "$push_after" "$wt"
done <<EOF
$WORKTREES
EOF

if [ "$apply" -eq 0 ]; then
  echo
  echo "run: git spread --apply"
  exit 0
fi

if [ -z "$PLAN" ]; then
  echo
  echo "nothing to do"
  exit 0
fi

echo
echo "starting in 5 seconds, ctrl-c to abort"
sleep 5
echo

# Decides nothing. Every choice was made in the pass above and is on screen.
while IFS="$TAB" read -r action branch stash_first push_after wt; do
  [ -z "$action" ] && continue

  stashed=0
  if [ "$stash_first" -eq 1 ]; then
    if git -C "$wt" stash push --quiet --include-untracked; then
      stashed=1
    else
      printf '❌ %s [%s]: stash failed — skipping\n' "$wt" "$branch"
      continue
    fi
  fi

  if [ "$action" = ff ]; then
    if git -C "$wt" merge --ff-only --quiet "$target" 2>/dev/null; then
      printf '✅ %s [main]: fast-forwarded\n' "$wt"
    else
      printf '⚠️  %s [main]: cannot fast-forward (local commits?) — skipped\n' "$wt"
    fi
  elif [ "$action" = merge ]; then
    # The branch name, not "$target": git builds the default merge message from
    # what it is given, and a raw sha writes "Merge commit '<sha>'". The ref is
    # local and only moves on fetch, and this run fetched once at the start, so
    # naming it cannot pick up a commit the plan did not print.
    if git -C "$wt" merge --quiet --no-edit origin/main >/dev/null 2>&1; then
      if [ "$push_after" -eq 1 ]; then
        if git -C "$wt" push --quiet 2>/dev/null; then
          printf '✅ %s [%s]: merged origin/main, pushed\n' "$wt" "$branch"
        else
          printf '⚠️  %s [%s]: merged, but push failed (remote moved?) — push manually\n' "$wt" "$branch"
        fi
      else
        printf '✅ %s [%s]: merged origin/main\n' "$wt" "$branch"
      fi
    else
      git -C "$wt" merge --abort 2>/dev/null
      printf '⚠️  %s [%s]: merge conflict — aborted, untouched\n' "$wt" "$branch"
    fi
  else
    if git -C "$wt" rebase --quiet "$target" >/dev/null 2>&1; then
      if [ "$push_after" -eq 1 ]; then
        if git -C "$wt" push --quiet --force-with-lease 2>/dev/null; then
          printf '✅ %s [%s]: rebased onto origin/main, force-pushed (lease held)\n' "$wt" "$branch"
        else
          printf '⚠️  %s [%s]: rebased, but push refused (lease failed — remote moved?) — push manually\n' "$wt" "$branch"
        fi
      else
        printf '✅ %s [%s]: rebased onto origin/main\n' "$wt" "$branch"
      fi
    else
      git -C "$wt" rebase --abort 2>/dev/null
      printf '⚠️  %s [%s]: rebase conflict — aborted, untouched\n' "$wt" "$branch"
    fi
  fi

  if [ "$stashed" -eq 1 ]; then
    if git -C "$wt" stash pop --quiet; then
      printf '   stash restored\n'
    else
      printf '❌ %s [%s]: stash pop failed — resolve manually (stash kept)\n' "$wt" "$branch"
    fi
  fi
done <<EOF
$PLAN
EOF
