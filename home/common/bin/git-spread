#!/bin/sh
# Spread the default branch into every worktree of the current repo.
# Dry run by default; --apply to act; --stash to stash dirty trees first.
#   git spread                 print the plan, touch nothing
#   git spread --apply         print the plan, pause 5 seconds, then carry it out
#   git spread --stash         dry run, counting dirty trees as stashable
#   git spread --stash --apply as --apply, stashing dirty trees first
# Per worktree: the default branch fast-forwards only; a branch that has already
# merged it merges again; every other branch rebases onto it.
# The strategy follows the branch's own history, because rebasing a branch that
# merged main would flatten that merge and discard whatever was resolved in it.
# A conflicted rebase or merge is aborted and reported, never left half-done.
# Upstreams: a branch that has genuinely diverged from its own remote is
# skipped (resolve the branch's own story first). A branch whose upstream
# was an ancestor is rebased and then pushed --force-with-lease — safe here
# because the lease reflects the fetch this same run just did. A branch that
# merges rewrites nothing, so its push is an ordinary fast-forward, no lease.
# A branch cut from another branch is skipped: see branch_cut_from in the lib.

set -u

DIR=$(cd "$(dirname "$0")" && pwd)
TOOL='git spread'
# SCRIPTDIR makes shellcheck resolve the path below against this file rather
# than against whatever directory it happens to be run from. A directive applies
# to the command after it, so both must sit against the source line itself.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/git-common.sh
. "$DIR/../lib/git-common.sh"

apply=0
stash=0
for arg in "$@"; do
  case "$arg" in
    --apply) apply=1 ;;
    --stash) stash=1 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

TAB=$(printf '\t')
PLAN=''
VERBOSE=false
BASE_OVERRIDE=''

ensure_in_git_repository
# run_update writes git's own failure message here so it can report the real
# reason rather than calling everything a conflict.
CACHE_DIR="$(git rev-parse --git-dir)/cleanup-cache"
mkdir -p "$CACHE_DIR"

echo "fetching origin (prune)..."
git fetch --quiet --prune origin || { echo "❌ fetch failed" >&2; exit 1; }
resolve_main
target=$(git rev-parse --verify --quiet "$MAIN_REF")

# Fed by here-doc, not by a pipe: a while loop downstream of a pipe runs in a
# subshell, and the plan it built would be discarded at 'done'.
WORKTREES=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10)}')

while IFS= read -r wt; do
  [ -z "$wt" ] && continue
  branch=$(git -C "$wt" symbolic-ref --quiet --short HEAD)
  if [ -z "$branch" ]; then
    printf '⚠️  %s: detached HEAD — skipping\n' "$wt"
    continue
  fi

  dirty=$(git -C "$wt" status --porcelain)
  behind=$(git -C "$wt" rev-list --count "HEAD..$target")
  ahead=$(git -C "$wt" rev-list --count "$target..HEAD")
  # $target is a resolved sha, so it carries no ambiguity of its own.

  upstream=$(git -C "$wt" rev-parse --verify --quiet '@{u}')
  # Upstream configured but the remote-tracking ref pruned away: the remote
  # branch was deleted (merged PR). Not ours to rebase - it's a cleanup
  # candidate.
  if [ -z "$upstream" ] && [ -n "$(git -C "$wt" config "branch.$branch.merge")" ]; then
    printf '🧹 %s [%s]: upstream gone (merged and deleted?) — skipping, cleanup candidate\n' "$wt" "$branch"
    continue
  fi
  push_after=0
  if [ -n "$upstream" ] && [ "$branch" != "$MAIN" ]; then
    if git -C "$wt" merge-base --is-ancestor "$upstream" HEAD; then
      push_after=1
    else
      printf '⛔ %s [%s]: diverged from its own remote — resolve that first, skipping\n' "$wt" "$branch"
      continue
    fi
  fi

  if [ "$behind" -eq 0 ]; then
    printf '✅ %s [%s]: up to date with origin/main\n' "$wt" "$branch"
    continue
  fi

  if [ -n "$dirty" ] && [ "$stash" -eq 0 ]; then
    printf '⚠️  %s [%s]: dirty — skipping (use --stash)\n' "$wt" "$branch"
    continue
  fi

  # Computed before the read: a here-doc is expanded as part of setting up the
  # command it feeds, so the substitution would run with IFS already set to tab.
  verdict=$(update_verdict "$wt" "$branch")
  IFS="$TAB" read -r action detail <<EOF
$verdict
EOF

  if [ "$action" = none ]; then
    printf '⛔ %s [%s]: %s — skipping, rebase it yourself\n' "$wt" "$branch" "$detail"
    continue
  fi

  # All three icons are double-width with no variation selector, so they take one
  # trailing space and line up with ✅. The ⚠️ used elsewhere is a narrow base
  # character wearing FE0F, which is why that one is written with two.
  case "$action" in
    ff)     verb="fast-forward to"; icon='⏩' ;;
    merge)  verb="merge";           icon='🔀' ;;
    *)      verb="rebase onto";     icon='🔁' ;;
  esac

  stash_first=0
  [ -n "$dirty" ] && stash_first=1

  extra=""
  [ "$stash_first" -eq 1 ] && extra=" (stash first)"
  if [ "$push_after" -eq 1 ]; then
    if [ "$action" = merge ]; then
      extra="$extra + push"
    else
      extra="$extra + force-push (with lease)"
    fi
  fi

  word=would
  [ "$apply" -eq 1 ] && word=will
  printf '%s %s [%s]: %s %s origin/%s (behind %s, ahead %s)%s\n' \
    "$icon" "$wt" "$branch" "$word" "$verb" "$MAIN" "$behind" "$ahead" "$extra"

  [ "$apply" -eq 1 ] && plan_add "$action" "$branch" "$stash_first" "$push_after" "$wt"
done <<EOF
$WORKTREES
EOF

if [ "$apply" -eq 0 ]; then
  echo
  echo "run: git spread --apply"
  exit 0
fi

if [ -z "$PLAN" ]; then
  echo
  echo "nothing to do"
  exit 0
fi

echo
echo "starting in 5 seconds, ctrl-c to abort"
sleep 5
echo

# Decides nothing. Every choice was made in the pass above and is on screen.
while IFS="$TAB" read -r action branch stash_first push_after wt; do
  [ -z "$action" ] && continue

  stashed=0
  if [ "$stash_first" -eq 1 ]; then
    if git -C "$wt" stash push --quiet --include-untracked; then
      stashed=1
    else
      printf '❌ %s [%s]: stash failed — skipping\n' "$wt" "$branch"
      continue
    fi
  fi

  # One implementation, in the library, shared with git refresh. It works out
  # whether to push from the branch's own upstream rather than being told.
  run_update "$action" "$branch" "$wt"

  if [ "$stashed" -eq 1 ]; then
    if git -C "$wt" stash pop --quiet; then
      printf '   stash restored\n'
    else
      printf '❌ %s [%s]: stash pop failed — resolve manually (stash kept)\n' "$wt" "$branch"
    fi
  fi
done <<EOF
$PLAN
EOF
