#!/bin/sh
#
# tmux-snapshot: save a tmux server's layout, and restore it after a crash or a
# restart. tmux-snapshot-watch runs `save` every few minutes, unattended.
#
#   tmux-snapshot                            what there is to restore, per label
#   tmux-snapshot [-L label | -a] save       save this server, -L's, or every one
#   tmux-snapshot [-L label] restore [--apply]
#   tmux-snapshot restore-server <label> [--apply]
#
# Restore is a dry run unless --apply is given. A failed save sets the server's
# @snapshot-error option, which the status bar shows; a successful one unsets it.
#
# DECISION: POSIX sh. The command runs periodically and unattended, and has to
# work then. It was Node before, and `#!/usr/bin/env node` runs whichever Node
# fnm has put first on PATH: that depends on the directory it is run from
# (fnm's --use-on-cd) and, for the watcher, on the PATH the tmux server
# inherited. That rules out Node, or any interpreter found through PATH that a
# version manager switches. Plan-then-execute is done the way git-refresh does
# it, with the plan as lines of data.
#
# The logic is in ../lib/tmux-snapshot.sh, and its header holds the traps. This
# file is argument parsing and a call into it. Through the symlink install.sh
# makes in ~/bin, the library is found at ~/lib, which install.sh also links.

set -u

DIR=$(cd "$(dirname "$0")" && pwd)

usage() {
  printf '%s\n' \
    'usage: tmux-snapshot [-L label | -a] save' \
    '       tmux-snapshot [-L label] restore [--apply]' \
    '       tmux-snapshot restore-server <label> [--apply]' >&2
  exit 2
}

LABEL='' LABEL_SET=0 ALL=0 APPLY=0
options=0 npos=0 SUB='' ARG=''

positional() {
  npos=$((npos + 1))
  case $npos in
    1) SUB=$1 ;;
    2) ARG=$1 ;;
  esac
}

# Options may sit either side of the subcommand.
while [ $# -gt 0 ]; do
  case $1 in
    -L | --label)
      [ $# -ge 2 ] || { echo "tmux-snapshot: $1 needs a label" >&2; usage; }
      LABEL=$2 LABEL_SET=1 options=1
      shift ;;
    --label=*) LABEL=${1#--label=} LABEL_SET=1 options=1 ;;
    -L*) LABEL=${1#-L} LABEL_SET=1 options=1 ;;
    -a | --all) ALL=1 options=1 ;;
    --apply) APPLY=1 options=1 ;;
    --)
      shift
      for a in "$@"; do positional "$a"; done
      break ;;
    -?*) echo "tmux-snapshot: unknown option '$1'" >&2; usage ;;
    *) positional "$1" ;;
  esac
  shift
done

# The bare command is the status view; options without a subcommand are not.
if [ "$npos" -eq 0 ]; then
  [ "$options" -eq 0 ] || usage
  SUB=status
else
  case $SUB in
    save | restore | restore-server) ;;
    *) usage ;;
  esac
fi

# A pull can leave this file updated and the library not, or the other way
# round, for a moment, and the watcher may run in it. A library that cannot be
# read, or does not define tmux_snapshot_main, ends the command before it
# touches any snapshot. The one thing it may write first is @snapshot-error,
# when the library cannot be read (below).
# A library that loads but is out of step with this file is not detected.
LIB=$DIR/../lib/tmux-snapshot.sh
if [ ! -r "$LIB" ]; then
  echo "tmux-snapshot: cannot read its library at $LIB" >&2
  # TODO(claude): undecided: whether a missing library is shown in the status
  # bar. For now a save named with -L (the watcher's form) sets @snapshot-error
  # on that server; a bare save or -a only says it here.
  if [ "$SUB" = save ] && [ "$LABEL_SET" = 1 ]; then
    tmux -L "$LABEL" set-option -s @snapshot-error "cannot read its library at $LIB" >/dev/null 2>&1 </dev/null
  fi
  exit 1
fi
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/tmux-snapshot.sh
. "$LIB"
command -v tmux_snapshot_main >/dev/null 2>&1 || {
  echo "tmux-snapshot: $LIB does not define tmux_snapshot_main" >&2
  exit 1
}

if [ "$SUB" = restore-server ] && [ "$npos" -ge 2 ]; then
  tmux_snapshot_main "$SUB" "$ARG"
else
  tmux_snapshot_main "$SUB"
fi
