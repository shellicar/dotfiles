#!/usr/bin/env node
// tmux-snapshot: capture the current tmux server's layout to JSON and rehydrate
// it later. Per pane it records session/window/pane identity, the exact window
// layout, the cwd, the foreground command, an allowlisted launcher (when the
// pane is running one), and the five custom user-options the status bar renders
// from.
//
// Node, not shell: restore is plan-then-execute (compute every action first,
// then either print it as the default dry-run, or run it under --apply), which
// is far cleaner with real objects than with shell word-splitting — and
// sidesteps the IFS field-collapse traps entirely, since tmux args are passed
// as an array, never re-split.
//
// Launcher detection: a pane's foreground is often a `node <script>` wrapper, so
// the real launcher is a descendant. We walk the pane's whole process tree
// (from /proc on Linux, or one `ps -axo` call on macOS) rather than one level of
// children, which misses it, and match the .mjs basename against the LAUNCHERS
// allowlist. Args are dropped on purpose: restore re-runs the script bare and
// lets it re-establish its own per-session state.
//
// Every tmux read is pinned to an explicit pane/window id; nothing relies on the
// "current" pane, which follows focus.

'use strict';

const fs = require('fs');
const { execFileSync } = require('child_process');
const { parseArgs } = require('node:util');

const HOME = process.env.HOME;

// Each server label gets its own directory under XDG data. Inside it, a proper
// double buffer: the new snapshot is drawn into a back-buffer temp while the
// front stays untouched, the front is copied aside to previous, then the temp is
// atomically renamed over the front. The front is never absent or half-written.
// No stat to pick a slot, no symlink.
function snapshotBase() {
  const base = process.env.XDG_DATA_HOME || `${HOME}/.local/share`;
  return `${base}/tmux/snapshot`;
}
function snapshotDir(label) {
  return `${snapshotBase()}/${label}`;
}
function saveSnapshot(label, snapshot) {
  const dir = snapshotDir(label);
  fs.mkdirSync(dir, { recursive: true });
  const front = `${dir}/current.json`;
  const back = `${dir}/previous.json`;
  const draw = `${dir}/.writing.${process.pid}.json`; // per-process temp, so concurrent saves never share a file
  fs.writeFileSync(draw, JSON.stringify(snapshot, null, 2) + '\n');
  // Copy the current front aside to previous (the front stays intact), then
  // rename the finished back buffer over it: current.json is never absent and
  // never half-written, so a reader always sees one complete frame.
  try { fs.copyFileSync(front, back); } catch { /* no prior frame yet */ }
  fs.renameSync(draw, front);
  return front;
}
// Read the front buffer, falling back to the retained previous frame only if the
// front is unreadable. Front first, no stat to decide.
function readSnapshot(label) {
  const dir = snapshotDir(label);
  for (const name of ['current.json', 'previous.json']) {
    const p = `${dir}/${name}`;
    try {
      const s = JSON.parse(fs.readFileSync(p, 'utf8'));
      if (s && Array.isArray(s.panes)) return { path: p, snapshot: s };
    } catch { /* try previous */ }
  }
  return null;
}

// tmux keeps one socket per server in a per-uid directory; the socket filename
// is the server label. Single source of both the server list and each path.
function serverDir() {
  return `/tmp/tmux-${process.getuid()}`;
}

// The labels of the servers that currently exist: the sockets in serverDir().
// A missing directory (no server ever started) reads as none.
function listServers() {
  let names;
  try {
    names = fs.readdirSync(serverDir());
  } catch {
    return [];
  }
  return names.filter((n) => {
    try {
      return fs.statSync(`${serverDir()}/${n}`).isSocket();
    } catch {
      return false;
    }
  });
}

// The label of the server we're running inside, from $TMUX's socket path.
function currentLabel() {
  const socket = process.env.TMUX.split(',')[0]; // e.g. /tmp/tmux-501/shellicar
  return socket.slice(socket.lastIndexOf('/') + 1);
}
const SEP = '\x1f'; // US: a field separator that cannot appear in tmux values
const PARK = '999999'; // parking index for the throwaway window new-session spawns

// The launchers restore re-runs bare (no args): a pane whose foreground node
// process runs one of these .mjs scripts is relaunched by basename, since the
// script re-establishes its own per-session state. Everything else restores to
// a plain shell. Kept as a small allowlist so unrelated commands (a stray dev
// server, swe.mjs with its args) are never resurrected.
const LAUNCHERS = new Set(['start-v2.mjs']);

function die(msg) {
  process.stderr.write(`tmux-snapshot: ${msg}\n`);
  process.exit(1);
}

function note(msg) {
  process.stderr.write(`tmux-snapshot: ${msg}\n`);
}

// allowFail says a failure here is expected and handled, which makes the
// command's own complaint noise: one "error connecting" line per dead socket,
// and the status view probes every label there is.
function run(cmd, args, allowFail) {
  try {
    return execFileSync(cmd, args, { encoding: 'utf8', stdio: allowFail ? ['pipe', 'pipe', 'ignore'] : undefined });
  } catch (e) {
    if (allowFail) return (e.stdout || '').toString();
    throw e;
  }
}

// A tmux caller bound to one server by label, so every command targets that
// named server rather than the ambient one $TMUX points at.
const serverTmux = (label) => (args, allowFail) => run('tmux', ['-L', label, ...args], allowFail);
const lines = (s) => (s || '').split('\n').filter(Boolean);

// Minimal ANSI, only when stdout is a terminal so piped/redirected output stays
// clean. Used to make the restore plan easier to scan at a glance.
const COLOUR = process.stdout.isTTY;
const paint = (code) => (s) => (COLOUR ? `\x1b[${code}m${s}\x1b[0m` : s);
const dim = paint('2');
const bold = paint('1');

function requireTmux() {
  if (!process.env.TMUX) die('not inside a tmux server');
}

// The orphan trap: if this pane's server was orphaned — its socket removed and a
// fresh server started on the same label — then `-L <label>` reaches that other
// server, not the one we're inside, and a bare command would silently snapshot
// the wrong server. $TMUX's second field is our real server's pid; display-message
// reports the pid the socket resolves to now. A mismatch means we're the orphan.
// Only meaningful for a bare command (label from $TMUX); an explicit -L is a
// deliberate target, not "the server I'm in".
function assertNotOrphan(label, tmux) {
  const envPid = process.env.TMUX.split(',')[1];
  const livePid = (tmux(['display-message', '-p', '#{pid}'], true) || '').trim();
  if (livePid !== envPid) {
    die(`this pane belongs to an orphaned '${label}' server (pid ${envPid}); the '${label}' socket now points at ${livePid ? `pid ${livePid}` : 'nothing'}. Run from a live pane, or target it explicitly with -L.`);
  }
}

// Resolve the target as a { label, tmux } pair. -L names the server explicitly;
// otherwise it's the one we're inside (requires being inside one). Either way
// every command binds to the label with -L — tmux uses -L internally regardless,
// so normalising to it keeps one code path and pins the target exactly. For the
// bare case we also guard against the orphan trap before handing the target back.
function resolveTarget(values) {
  if (values.label !== undefined) return { label: values.label, tmux: serverTmux(values.label) };
  requireTmux();
  const label = currentLabel();
  const tmux = serverTmux(label);
  assertNotOrphan(label, tmux);
  return { label, tmux };
}

// --- save -------------------------------------------------------------------

// The allowlisted launcher among a pane's processes, or null: the first .mjs
// basename in LAUNCHERS. Args are ignored on purpose: restore re-runs it bare.
function detectLauncher(panePid, reader) {
  for (const line of walkTree(panePid, reader)) {
    const m = line.match(/([^/\s]+\.mjs)\b/);
    if (m && LAUNCHERS.has(m[1])) return m[1];
  }
  return null;
}

// One walk for both platforms: descend the pane's process tree from its shell
// and collect each process's command. Descendants rather than one level,
// because the launcher usually sits under a `node <script>` wrapper. A reader
// supplies the two per-process facts, and only the reader is platform-specific.
function walkTree(rootPid, reader) {
  const out = [];
  const queue = [String(rootPid)];
  const seen = new Set();
  while (queue.length) {
    const pid = queue.shift();
    if (seen.has(pid)) continue; // a pid cannot be its own ancestor, but never loop on a malformed tree
    seen.add(pid);
    const cmd = reader.command(pid);
    if (cmd) out.push(cmd);
    queue.push(...reader.children(pid));
  }
  return out;
}

// The reader for this machine, built once per save: /proc where there is one,
// otherwise ps. The probe is /proc itself, not the OS, since what the reader
// needs is those files and a Mac has none of them.
function processReader() {
  return fs.existsSync('/proc/self/stat') ? procReader() : psReader();
}

// Linux: read /proc directly, and skip any process with a thread in state D.
// Reading a cmdline takes the target's mmap lock, so it blocks for as long as a
// thread stuck in the kernel holds that lock. ps reads every process's cmdline
// whenever its format includes a command-name field (comm, command, args),
// whatever -p or -t selects, so one stuck process anywhere blocks it. The ps
// reader below needs command, which is why Linux cannot share it. D is the
// only state that can block, and stat and children take no such lock, so a
// wedged pane costs its own launcher and nothing else.
function procReader() {
  const read = (p) => { try { return fs.readFileSync(p, 'utf8'); } catch { return ''; } };
  const tids = (pid) => { try { return fs.readdirSync(`/proc/${pid}/task`); } catch { return []; } }; // exited
  // stat's second field is comm in parens and may itself contain spaces and
  // parens, so state is read from after the last ')', never by splitting.
  const inD = (stat) => stat.slice(stat.lastIndexOf(')') + 2).split(' ')[0] === 'D';
  // Every thread, because /proc/<pid>/stat reports the main thread alone and
  // the thread holding the lock can be any of them.
  const wedged = (pid) => tids(pid).some((tid) => inD(read(`/proc/${pid}/task/${tid}/stat`)));
  return {
    command: (pid) => (wedged(pid) ? '' : read(`/proc/${pid}/cmdline`).split('\0').join(' ').trim()),
    children: (pid) => tids(pid).flatMap((tid) => read(`/proc/${pid}/task/${tid}/children`).split(' ').filter(Boolean)),
  };
}

// No /proc (macOS): one ps for the whole machine, read once and indexed by pid,
// so a save forks once however many panes it has. ps prints ppid before the
// command, and a command contains spaces, so the line is split twice and the
// remainder kept whole.
function psReader() {
  const byPid = new Map();
  const kids = new Map();
  // -ww so ps never cuts a command line to a width, which could drop a long
  // launcher path's .mjs. The whole table can be large, so the buffer is raised,
  // and overflowing it fails the save: a cut-off table would lose launchers
  // silently.
  // TODO: untested on macOS. On a Mac, check that
  //   ps -axo pid=,ppid=,command= -ww | awk '{ print length }' | sort -n | tail -1
  // shows uncut lines, and that a launcher with a long path is still detected.
  const maxBuffer = 64 * 1024 * 1024;
  let out;
  try {
    out = execFileSync('ps', ['-ww', '-axo', 'pid=,ppid=,command='],
      { encoding: 'utf8', stdio: ['pipe', 'pipe', 'ignore'], maxBuffer });
  } catch (e) {
    if (e.code === 'ENOBUFS') die(`ps output exceeded ${maxBuffer} bytes; not saving a partial process table`);
    out = (e.stdout || '').toString();
  }
  for (const line of out.split('\n')) {
    const m = line.match(/^\s*(\d+)\s+(\d+)\s+(.*)$/);
    if (!m) continue;
    const [, pid, ppid, cmd] = m;
    byPid.set(pid, cmd);
    if (!kids.has(ppid)) kids.set(ppid, []);
    kids.get(ppid).push(pid);
  }
  return {
    command: (pid) => byPid.get(pid) || '',
    children: (pid) => kids.get(pid) || [],
  };
}

function saveServer(label, tmux) {
  const fmt = [
    '#{session_name}', '#{window_index}', '#{window_name}',
    '#{window_layout}', '#{pane_index}', '#{pane_current_path}',
    '#{pane_current_command}', '#{@title}', '#{@colour}', '#{@state}',
    '#{@role}', '#{@status}', '#{pane_pid}',
  ].join(SEP);

  // A stale socket (file present but server dead) makes list-panes fail hard.
  // allowFail turns that into empty output; a live server always reports at
  // least one pane, so empty means no server — skip cleanly, don't crash.
  const raw = tmux(['list-panes', '-a', '-F', fmt], true);
  if (!raw) {
    note(`no server running on '${label}', nothing to save`);
    return;
  }

  const rows = lines(raw);

  // Fresh-server guard: a lone session/window/pane is an empty server just
  // started (or a crash that left nothing). Saving it would overwrite the last
  // known-good snapshot with nothing worth restoring, so skip.
  if (rows.length === 1) {
    note(`server '${label}' has a single pane (fresh/empty), not saving`);
    return;
  }

  note(`saving server '${label}'`);
  const reader = processReader(); // built once, shared by every pane
  const panes = rows.map((line) => {
    const [
      session, windowIndex, windowName, windowLayout, paneIndex,
      path, cmd, title, colour, state, role, status, panePid,
    ] = line.split(SEP);

    return {
      session, window_index: windowIndex, window_name: windowName,
      window_layout: windowLayout, pane_index: paneIndex, path, cmd,
      launcher: detectLauncher(panePid, reader),
      options: {
        '@title': title, '@colour': colour, '@state': state,
        '@role': role, '@status': status,
      },
    };
  });

  const snapshot = {
    generated: new Date().toISOString(),
    socket: `${serverDir()}/${label}`,
    panes,
  };
  const file = saveSnapshot(label, snapshot);
  process.stdout.write(summarize(panes) + '\n');
  note(`wrote ${panes.length} panes to ${file}`);
}

// save router: -a sweeps every server, -L names one, else the current server.
function cmdSave(values) {
  if (values.all) {
    if (values.label !== undefined) die('cannot combine -a with -L');
    const servers = listServers();
    if (!servers.length) die('no tmux servers found');
    for (const label of servers) saveServer(label, serverTmux(label));
    return;
  }
  const { label, tmux } = resolveTarget(values);
  saveServer(label, tmux);
}

// A readable tree of what was captured: session → window → panes, each pane
// showing its resolved process and cwd.
function summarize(panes) {
  const out = [];
  let lastSession = null;
  for (const w of groupWindows(panes)) {
    if (w.session !== lastSession) {
      out.push(w.session);
      lastSession = w.session;
    }
    const n = w.panes.length;
    out.push(`  ${w.window_index}  ${w.window_name}  (${n} pane${n > 1 ? 's' : ''})`);
    for (const p of w.panes) {
      const l = p.launcher ? `  (launcher: ${p.launcher})` : '';
      out.push(`       ${p.pane_index}  ${p.cmd.padEnd(15)} ${p.path}${l}`);
    }
  }
  return out.join('\n');
}

// --- restore ----------------------------------------------------------------

// Group panes into windows (ordered by session, then numeric window index;
// panes within a window ordered by numeric pane index).
function groupWindows(panes) {
  const map = new Map();
  for (const p of panes) {
    const key = `${p.session}${SEP}${p.window_index}`;
    if (!map.has(key)) {
      map.set(key, {
        session: p.session, window_index: p.window_index,
        window_name: p.window_name, window_layout: p.window_layout, panes: [],
      });
    }
    map.get(key).panes.push(p);
  }
  const windows = [...map.values()];
  windows.sort((a, b) =>
    a.session < b.session ? -1 : a.session > b.session ? 1
      : Number(a.window_index) - Number(b.window_index));
  for (const w of windows) w.panes.sort((a, b) => Number(a.pane_index) - Number(b.pane_index));
  return windows;
}

// Work out, against the live server, exactly what restore would do. Returns a
// plan that both the default dry-run and an --apply run consume, so the preview
// can never diverge from what executes.
function planRestore(snapshot, tmux) {
  const windows = groupWindows(snapshot.panes);

  const liveSessions = new Set(lines(tmux(['list-sessions', '-F', '#{session_name}'], true)));
  const liveWindows = {};
  for (const s of liveSessions) {
    liveWindows[s] = new Set(lines(tmux(['list-windows', '-t', `=${s}`, '-F', '#{window_index}'], true)));
  }

  const wantedSessions = [...new Set(snapshot.panes.map((p) => p.session))];
  const createSessions = wantedSessions.filter((s) => !liveSessions.has(s));

  const createWindows = [];
  const skipWindows = [];
  for (const w of windows) {
    const exists = liveSessions.has(w.session) && liveWindows[w.session].has(String(w.window_index));
    (exists ? skipWindows : createWindows).push(w);
  }

  return { createSessions, createWindows, skipWindows };
}

function describePlan(plan) {
  const out = [];
  for (const s of plan.createSessions) out.push(`create session: ${s}`);
  for (const w of plan.createWindows) {
    const n = w.panes.length;
    out.push(`create window: ${bold(`${w.session}:${w.window_index}`)} "${w.window_name}" (${n} pane${n > 1 ? 's' : ''})`);
    for (const p of w.panes) {
      const exists = fs.existsSync(p.path);
      out.push(`    pane ${p.pane_index}: cwd=${p.path}${exists ? '' : dim(' (missing, opens in ~)')}`);
      if (p.launcher) {
        if (exists) out.push(`      ${dim('run:')} ${bold(p.launcher)}`);
        else out.push(`      ${dim(`skip ${p.launcher}: dir missing`)}`);
      }
    }
  }
  for (const w of plan.skipWindows) out.push(dim(`skip window: ${w.session}:${w.window_index} (exists)`));
  return out;
}

function executePlan(plan, tmux) {
  // Create missing sessions detached; park the auto-spawned window so our
  // indexed windows are free, and reap it once the session has real windows
  // (killing it sooner could take the session with it and fire session-closed).
  const created = [];
  for (const s of plan.createSessions) {
    tmux(['new-session', '-d', '-s', s, '-x', '270', '-y', '85']);
    const ph = lines(tmux(['list-windows', '-t', `=${s}`, '-F', '#{window_id}']))[0];
    tmux(['move-window', '-s', ph, '-t', `${s}:${PARK}`]);
    created.push(s);
  }

  // Stage 1: build the structure. Create every window and pane, apply the saved
  // layout, set the window/pane labels. Panes are created regardless of whether
  // their saved cwd still exists (tmux falls back to HOME for a missing dir), so
  // the pane count matches the saved layout and the geometry fits exactly.
  for (const w of plan.createWindows) {
    const tgt = `${w.session}:${w.window_index}`;

    // First pane via new-window, the rest via split, re-applying the saved
    // layout after every one. Applying it once at the end cannot work: each
    // unguided split halves the room the panes already have, so they shrink
    // geometrically until a split has nowhere to go. Re-applying spreads what
    // exists over the whole window each time; tmux drops the cells it has no
    // pane for yet, and only refuses the reverse.
    //
    // -f splits the whole window. Without it tmux splits the active pane, which
    // the re-applied layout can have put in a one-row cell (a status line under
    // a pane, say), and a one-row pane cannot be split. -f also always adds the
    // new pane last, so pane N is created with saved pane N's cwd.
    w.panes.forEach((p, i) => {
      if (i === 0) tmux(['new-window', '-t', tgt, '-n', w.window_name, '-c', p.path]);
      else tmux(['split-window', '-f', '-t', tgt, '-c', p.path]);
      tmux(['select-layout', '-t', tgt, w.window_layout]);
    });

    // Window-scope labels (title/colour/state) — shared across the window's
    // panes, taken from the first.
    const o = w.panes[0].options;
    if (o['@title']) tmux(['set-option', '-w', '-t', tgt, '@title', o['@title']]);
    if (o['@colour']) tmux(['set-option', '-w', '-t', tgt, '@colour', o['@colour']]);
    if (o['@state']) tmux(['set-option', '-w', '-t', tgt, '@state', o['@state']]);

    for (const p of w.panes) {
      const pt = `${tgt}.${p.pane_index}`;
      // Pane-scope labels (role/status).
      if (p.options['@role']) tmux(['set-option', '-p', '-t', pt, '@role', p.options['@role']]);
      if (p.options['@status']) tmux(['set-option', '-p', '-t', pt, '@status', p.options['@status']]);
    }
  }

  // Stage 2: relaunch the allowlisted launchers, separately from the layout.
  // Only launch when the pane's saved dir still exists: a missing dir would have
  // landed the pane in HOME, and starting the launcher there is worse than
  // leaving a plain shell. The launcher runs bare and re-establishes its own
  // per-session state.
  for (const w of plan.createWindows) {
    for (const p of w.panes) {
      if (!p.launcher) continue;
      if (!fs.existsSync(p.path)) continue;
      const pt = `${w.session}:${w.window_index}.${p.pane_index}`;
      tmux(['send-keys', '-t', pt, '-l', p.launcher]);
      tmux(['send-keys', '-t', pt, 'Enter']);
    }
  }

  for (const s of created) tmux(['kill-window', '-t', `${s}:${PARK}`], true);
}

function cmdRestore(values) {
  if (values.all) die('-a is not supported for restore (single server only)');
  // Dry-run is the default: print the plan and change nothing. --apply commits.
  const apply = Boolean(values.apply);
  const { label, tmux } = resolveTarget(values);
  note(`restoring server '${label}'`);

  const found = readSnapshot(label);
  if (!found) die(`no snapshot for '${label}' in ${snapshotDir(label)}`);
  const { path: file, snapshot } = found;

  const plan = planRestore(snapshot, tmux);

  if (!apply) {
    process.stdout.write('DRY RUN — no changes will be made (pass --apply to commit)\n');
    const desc = describePlan(plan);
    if (desc.length) process.stdout.write(desc.join('\n') + '\n');
    note(`would create ${plan.createSessions.length} session(s), ${plan.createWindows.length} window(s); skip ${plan.skipWindows.length} existing`);
    return;
  }

  executePlan(plan, tmux);
  note(`restore complete from ${file} — created ${plan.createWindows.length} window(s), skipped ${plan.skipWindows.length}`);
}

// restore-server takes the label as a positional (`restore-server weaver`) and
// drives the same plan/execute path as `restore` — dry-run by default, --apply to
// commit. It exists to be run from *outside* the target server (the save → kill
// → restore cycle can't be driven from inside the server it's killing), where the
// -L flag reads as less obvious than a named label.
function cmdRestoreServer(values, label) {
  if (label === undefined) die('restore-server requires a label (e.g. restore-server weaver)');
  if (values.all) die('-a is not supported for restore-server (single server only)');
  cmdRestore({ ...values, label });
}

// --- status -----------------------------------------------------------------

// Bare `tmux-snapshot` answers "what can I restore, and would it do anything?".
// The rows are the union of the labels holding a snapshot and the servers
// running now: a running server with no snapshot is one nothing is protecting,
// and a snapshot with no server is one waiting to be restored. The restore
// column comes from the planner `restore` itself uses, so it cannot promise
// work the real command would not do.

const COLUMNS = [
  { head: 'label' },
  { head: 'saved' },
  { head: 'sessions', right: true },
  { head: 'windows', right: true },
  { head: 'panes', right: true },
  { head: 'server' },
  { head: 'restore' },
];

// The labels that have a snapshot directory. Only directories: the base also
// holds a stray file from an older layout, which is not a label.
function snapshotLabels() {
  try {
    return fs.readdirSync(snapshotBase(), { withFileTypes: true })
      .filter((e) => e.isDirectory())
      .map((e) => e.name);
  } catch {
    return [];
  }
}

// Spelled out rather than taken from a locale: en-AU abbreviates to July and
// Sept, so the column would jitter between three and four characters.
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const pad2 = (n) => String(n).padStart(2, '0');

// Precision where it helps: the clock for a snapshot taken today, the date for
// anything older, the year once it is not this one.
function when(iso) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '?';
  const now = new Date();
  if (d.toDateString() === now.toDateString()) return `today ${pad2(d.getHours())}:${pad2(d.getMinutes())}`;
  const day = `${d.getDate()} ${MONTHS[d.getMonth()]}`;
  return d.getFullYear() === now.getFullYear() ? `${day} ${pad2(d.getHours())}:${pad2(d.getMinutes())}` : `${day} ${d.getFullYear()}`;
}

const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;

function statusRows() {
  const labels = [...new Set([...snapshotLabels(), ...listServers()])].sort();
  const rows = [];
  for (const label of labels) {
    const tmux = serverTmux(label);
    // Liveness is whether the socket answers, not whether it exists: a dead
    // server can leave its socket behind.
    const running = lines(tmux(['list-sessions', '-F', '#{session_name}'], true)).length > 0;
    const found = readSnapshot(label);
    // Neither a snapshot nor a server is a leftover directory, not a row.
    if (!found && !running) continue;
    if (!found) {
      rows.push([label, '-', '-', '-', '-', 'running', 'no snapshot']);
      continue;
    }
    const { panes } = found.snapshot;
    const plan = planRestore(found.snapshot, tmux);
    const todo = [];
    if (plan.createSessions.length) todo.push(plural(plan.createSessions.length, 'session'));
    if (plan.createWindows.length) todo.push(plural(plan.createWindows.length, 'window'));
    rows.push([
      label,
      when(found.snapshot.generated),
      String(new Set(panes.map((p) => p.session)).size),
      String(groupWindows(panes).length),
      String(panes.length),
      running ? 'running' : '-',
      todo.length ? todo.join(', ') : 'up to date',
    ]);
  }
  return rows;
}

// Columns sized to their contents, counts right-aligned so they read as numbers.
// Colour goes on after padding, since the escape codes are not printed width.
function renderTable(rows) {
  const all = [COLUMNS.map((c) => c.head), ...rows];
  const widths = COLUMNS.map((c, i) => Math.max(...all.map((r) => r[i].length)));
  const out = all.map((r) => r
    .map((cell, i) => (COLUMNS[i].right ? cell.padStart(widths[i]) : cell.padEnd(widths[i])))
    .join('  ')
    .trimEnd());
  out[0] = dim(out[0]);
  return out.join('\n');
}

function cmdStatus() {
  const rows = statusRows();
  process.stdout.write(rows.length ? `${renderTable(rows)}\n\n` : 'no snapshots, no servers running\n\n');
  process.stdout.write(usageLines().join('\n') + '\n');
}

// --- dispatch ---------------------------------------------------------------

function usageLines() {
  return [
    'usage: tmux-snapshot [-L label | -a] save',
    '       tmux-snapshot [-L label] restore [--apply]',
    '       tmux-snapshot restore-server <label> [--apply]',
  ];
}

function usage() {
  process.stderr.write(usageLines().join('\n') + '\n');
  process.exit(2);
}

// parseArgs in strict mode: unknown flags throw and land on usage(). -L/-a and
// --apply are position-independent, so the subcommand may sit either side.
function main() {
  let parsed;
  try {
    parsed = parseArgs({
      allowPositionals: true,
      options: {
        label: { type: 'string', short: 'L' },
        all: { type: 'boolean', short: 'a' },
        apply: { type: 'boolean' },
      },
    });
  } catch (e) {
    note(e.message);
    usage();
  }

  const sub = parsed.positionals[0];
  // Bare invocation is the status view: what there is to restore, then how to.
  if (sub === undefined && Object.keys(parsed.values).length === 0) return cmdStatus();
  if (sub === 'save') cmdSave(parsed.values);
  else if (sub === 'restore') cmdRestore(parsed.values);
  else if (sub === 'restore-server') cmdRestoreServer(parsed.values, parsed.positionals[1]);
  else usage();
}

main();
