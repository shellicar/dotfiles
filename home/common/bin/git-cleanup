#!/bin/sh
#
# git cleanup — delete local branches (and their worktrees) whose work is
# already in the main branch.
#
# Invoked as a git subcommand: git finds this file on $PATH as `git-cleanup`,
# so `git cleanup` runs it. Default is a dry-run report; nothing is deleted
# without --apply.
#
# THE DECISION is the merge check, and only the merge check: are the branch's
# commits already in main? Walking the branch tip-first, the first commit whose
# content is found in main is where the branch joins main; anything before it is
# work not yet in main.
#
#   0 commits not in main  → fully merged     → delete (and its worktree)
#   N commits not in main  → merged + N on top → review (kept)
#   no join point found    → not merged        → keep
#
# GONE IS ONLY AN INDICATOR. The remote branch being deleted says nothing about
# content; it is a cross-check against the verdict, and only matters when the
# two disagree:
#
#   merged  but NOT gone  → warn: content is in main yet the remote still exists
#   gone    but NOT merged → warn: remote deleted (likely squashed) yet its
#                            content cannot be found — look by hand
#
# gone never changes the verdict. Strip it away and the merge check reads the
# same.

set -u

# ── presentation ────────────────────────────────────────────────────────────

if [ -t 1 ]; then
  GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'
  DIM='\033[2m'; BOLD='\033[1m'; RESET='\033[0m'
else
  GREEN=''; YELLOW=''; RED=''; BLUE=''; DIM=''; BOLD=''; RESET=''
fi

OK='✅'; KEEP='•'; WARN='⚠️ '; NOACCESS='🚫'; EMPTYICON='≡'; UNKNOWN='?'; WOULDREMOVE='\342\235\227'

say() { printf '%b\n' "$*"; }
log() { [ "$VERBOSE" = true ] && printf '%b\n' "${DIM}[git cleanup] $*${RESET}" >&2; return 0; }

# A phase label printed before the phase runs, so a slow run shows where it is
# instead of sitting blank, then completed in place with its result. Under -v the
# label ends its own line, or the log output lands in the middle of it.
step() { printf '%b' "  ${DIM}$*${RESET} "; [ "$VERBOSE" = true ] && printf '\n'; return 0; }
step_done() { [ "$VERBOSE" = true ] && printf '    '; printf '%b\n' "${DIM}$*${RESET}"; return 0; }

# ── repository context ──────────────────────────────────────────────────────

ref_exists() { git rev-parse --verify --quiet "$1" >/dev/null 2>&1; }

ensure_in_git_repository() {
  git rev-parse --git-dir >/dev/null 2>&1 || { echo "Error: not in a git repository" >&2; exit 1; }
}

get_main_branch() (
  [ -n "$BASE_OVERRIDE" ] && { echo "$BASE_OVERRIDE"; return 0; }
  ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null) || {
    echo "Error: cannot determine main branch from origin/HEAD (try -b <branch>)" >&2; exit 1; }
  echo "$ref" | sed 's@^refs/remotes/origin/@@'
)

fetch_origin() {
  [ "$NO_FETCH" = true ] && { log "skipping fetch (--no-fetch)"; return 0; }
  log "fetching origin --prune ..."
  git fetch --prune origin >/dev/null 2>&1 || \
    echo "Warning: could not fetch from origin; proceeding with local data." >&2
}

# ── the merge check (the verdict) ───────────────────────────────────────────

# The stripped-diff CONTENT of a change: the diff with its ---/+++/@@/index
# header lines removed, then hashed for indexing. This is git-check.sh's
# comparison — the actual diff content, NOT a patch-id.
content_hash() {
  git diff "$1" "$2" | sed -e '/^--- /d' -e '/^+++ /d' -e '/^@@/d' -e '/^index /d' | shasum | awk '{print $1}'
}

# content_hash is a pure function of two immutable git SHAs — once a commit
# exists its diff against another commit never changes, so a cache entry
# never goes stale and needs no invalidation. Repo-local, under .git/, so it
# survives across runs but never leaks between repos.
content_hash_cached() (
  a=$1 b=$2
  key=$(printf '%s %s' "$a" "$b" | shasum | awk '{print $1}')
  file="$CACHE_DIR/$key"
  if [ -f "$file" ]; then
    h=$(cat "$file")
  else
    h=$(content_hash "$a" "$b")
    printf '%s\n' "$h" > "$file"
  fi
  # The newline matters: the main index is line-oriented, matched with grep -x.
  printf '%s\n' "$h"
)

# The PR host origin points at. Decided by the remote, not by which CLI happens
# to be installed, so a machine with both does not guess wrong.
pr_host() {
  case "$(git config --get remote.origin.url 2>/dev/null)" in
    *dev.azure.com*) echo azure ;;
    *github.com*) echo github ;;
    *) return 1 ;;
  esac
}

# org/project/repo of an Azure DevOps remote, tab separated. Both remote forms
# normalise to the same triple:
#   https://{org}@dev.azure.com/{org}/{project}/_git/{repo}
#   git@ssh.dev.azure.com:v3/{org}/{project}/{repo}
ado_coordinates() (
  url=$(git config --get remote.origin.url 2>/dev/null) || return 1
  case "$url" in
    *ssh.dev.azure.com:v3/*) path=${url#*ssh.dev.azure.com:v3/} ;;
    *) path=$(printf '%s' "${url#*dev.azure.com/}" | sed 's@/_git/@/@') ;;
  esac
  path=${path%.git}
  printf '%s\t%s\t%s\n' "$(printf '%s' "$path" | cut -d/ -f1)" "$(printf '%s' "$path" | cut -d/ -f2)" "$(printf '%s' "$path" | cut -d/ -f3)"
)

# One bulk fetch of every merged PR's source branch + merge commit, instead of
# an API call per branch (~0.5s network round-trip each — 50 branches would be
# 25s of pure latency). Populated once, in the tab-separated table
# PR_MERGE_TABLE looks up from. Azure DevOps reports the source branch as a full
# ref, so it is stripped to match the plain branch names on the other side.
# az answers an auth failure with a blanket 'az logout; az login', which tears
# down every other tenant's credentials to fix one org. This is the scoped form.
# The tenant is derived rather than configured, so it cannot drift from the
# subscription beside it.
ado_login_hint() {
  local t
  [ "${2:-}" = force ] || grep -qE 'Interactive authentication is needed|TF400813|az login' "$CACHE_DIR/az-error" 2>/dev/null || return 0
  # With a profile the browser picks the identity, so naming a tenant would only
  # constrain it wrongly. Without one, the tenant is what narrows the login.
  if [ -n "$AZ_CONFIG" ]; then
    PR_HINT="  ${DIM}run: AZURE_CONFIG_DIR=$AZ_CONFIG az login --scope $ADO_RESOURCE/.default${RESET}"
    return 0
  fi
  t=$(az account list --query "[?id=='$1'].tenantId | [0]" -o tsv 2>/dev/null) || return 0
  [ -n "$t" ] && PR_HINT="  ${DIM}run: az login --tenant $t --scope $ADO_RESOURCE/.default${RESET}"
  return 0
}

fetch_pr_merges() {
  PR_MERGE_TABLE=''; PR_SOURCE='no PR host'; PR_HINT=''; AZ_CONFIG=''
  local host coords raw sub org project repo token
  host=$(pr_host) || return 0
  case "$host" in
    azure)
      command -v az >/dev/null 2>&1 || { PR_SOURCE='azure devops, az missing'; return 0; }
      sub=$(git config --get cleanup.subscription) || { PR_SOURCE='azure devops, no subscription configured'; return 0; }
      coords=$(ado_coordinates) || return 0
      PR_SOURCE='azure devops'
      org=$(printf '%s' "$coords" | cut -f1); project=$(printf '%s' "$coords" | cut -f2); repo=$(printf '%s' "$coords" | cut -f3)
      # One az profile holds one login per subscription, so a second identity on the
      # same subscription evicts the first. A profile per org keeps both alive.
      AZ_CONFIG=$(git config --get cleanup.azconfig) || AZ_CONFIG=''
      case "$AZ_CONFIG" in "~/"*) AZ_CONFIG="$HOME/${AZ_CONFIG#\~/}" ;; esac
      [ -n "$AZ_CONFIG" ] && export AZURE_CONFIG_DIR="$AZ_CONFIG"
      log "ado org=[$org] project=[$project] repo=[$repo] sub=[$sub] azconfig=[$AZ_CONFIG]"
      # az rest authenticates as the default account and ignores the account
      # flags, which 403s against an org in another tenant, so the token is
      # fetched here and attached explicitly.
      # --subscription, never --tenant: a subscription resolves both the tenant and
      # the identity signed in for it, where --tenant names only the target and
      # leaves az using the default account's credentials. AAD then rejects them
      # with AADSTS50020 when that user is foreign to the tenant.
      token=$(az account get-access-token --subscription "$sub" --resource "$ADO_RESOURCE" --query accessToken -o tsv 2>"$CACHE_DIR/az-error") || { PR_SOURCE='azure devops, no token for subscription'; log "ado token error: $(cat "$CACHE_DIR/az-error")"; ado_login_hint "$sub" force; return 0; }
      # $top is an OData parameter, single-quoted so no shell expands it away.
      # Without it the API returns its default first page of 101, not the lot.
      raw=$(az rest --method get --skip-authorization-header --headers "Authorization=Bearer $token" --url "https://dev.azure.com/$org/$project/_apis/git/repositories/$repo/pullrequests" --uri-parameters searchCriteria.status=completed '$top=1000' api-version=7.1 --query 'value[?lastMergeCommit.commitId!=null].[sourceRefName, lastMergeCommit.commitId]' -o tsv 2>"$CACHE_DIR/az-error") || { PR_SOURCE='azure devops, query failed'; log "ado query error: $(cat "$CACHE_DIR/az-error")"; ado_login_hint "$sub"; return 0; }
      # An expired session gets Azure DevOps's HTML sign-in page with a 200, so az
      # exits 0, skips --query because the body is not JSON, and prints the page.
      # Rows are therefore validated, not trusted: branch, tab, 40 hex characters.
      PR_MERGE_TABLE=$(printf '%s' "$raw" | sed 's@^refs/heads/@@' | awk -F'\t' 'NF==2 && $2 ~ /^[0-9a-f]{40}$/')
      log "ado rows=$(printf '%s' "$PR_MERGE_TABLE" | grep -c .) of $(printf '%s' "$raw" | grep -c .) lines"
      if [ -z "$PR_MERGE_TABLE" ] && [ -n "$raw" ]; then
        PR_SOURCE='azure devops, not signed in'
        ado_login_hint "$sub" force
      fi
      ;;
    github)
      command -v gh >/dev/null 2>&1 || { PR_SOURCE='github, gh missing'; return 0; }
      PR_SOURCE='github'
      PR_MERGE_TABLE=$(gh pr list --state merged --json headRefName,mergeCommit --limit 1000 --jq '.[] | select(.mergeCommit != null) | [.headRefName, .mergeCommit.oid] | @tsv' 2>/dev/null) || { PR_SOURCE='github, query failed'; return 0; }
      ;;
  esac
}

# The squash/merge commit of a merged PR for this branch, looked up from the
# table fetch_pr_merges built once up front. Empty if none.
pr_merge_commit() {
  printf '%s\n' "$PR_MERGE_TABLE" | awk -F'\t' -v b="$1" '$1==b{print $2; exit}'
}

# Past the cap the content walk is skipped: main has moved far enough that the
# branch's paths have likely been restructured out from under the comparison, so
# the walk is both the expensive check and the futile one. Distance AND age,
# never either alone — a recent branch on a fast repo is far back but still
# comparable, and an old branch on a quiet repo is only a few commits to check.
# An explicitly named --branch is never capped: naming it says what --old says.
branch_beyond_cap() (
  [ "$EVALUATE_OLD" = true ] && return 1
  [ -n "$ONLY_BRANCHES" ] && return 1
  dist=$(git rev-list --count "origin/$MAIN" "^$1" 2>/dev/null) || return 1
  [ "$dist" -gt "$MAX_DISTANCE" ] || return 1
  last=$(git log -1 --format=%ct "$1" 2>/dev/null) || return 1
  [ $(( NOW - last )) -gt $(( MAX_AGE_DAYS * 86400 )) ]
)

# Commits main has moved past the branch's fork, for the inconclusive report.
distance_from_main() { git rev-list --count "origin/$MAIN" "^$1" 2>/dev/null || echo '?'; }

# How many main commits, back from the tip, we actually need indexed this
# run: the largest base..origin/$MAIN distance among branches that fail BOTH
# the ancestor check AND the PR check and are within the evaluation cap (only
# those ever fall through to the content walk). Not a fixed constant — the true
# maximum this run needs, and 0 (skip entirely) if none qualify.
compute_max_walk_depth() (
  max=0
  branches=${ONLY_BRANCHES:-$(git for-each-ref --format '%(refname:short)' refs/heads/)}
  for branch in $branches; do
    [ "$branch" = "$MAIN" ] && continue
    base=$(git merge-base "$branch" "origin/$MAIN" 2>/dev/null) || continue
    git merge-base --is-ancestor "$branch" "origin/$MAIN" 2>/dev/null && continue
    pr_mc=$(pr_merge_commit "$branch")
    [ -n "$pr_mc" ] && ref_exists "$pr_mc" && continue
    branch_beyond_cap "$branch" && continue
    dist=$(git rev-list --count "$base..origin/$MAIN" 2>/dev/null) || continue
    [ "$dist" -gt "$max" ] && max=$dist
  done
  echo "$max"
)

# ONE shared index of main's commit-content hashes, built once for the whole
# run at the size compute_max_walk_depth actually needs — not per branch, not
# a fixed 500. Every pending branch's own range is a prefix of this same set
# (both count back from origin/$MAIN's tip), so one walk covers all of them.
build_shared_main_index() {
  local depth c p
  depth=$(compute_max_walk_depth)
  # Repo-local and truncated per run, so nothing is left behind in $TMPDIR.
  MAIN_IDX="$CACHE_DIR/main-index"
  : > "$MAIN_IDX" || { echo "Error: cannot write $MAIN_IDX" >&2; exit 1; }
  [ "$depth" -eq 0 ] && return 0
  git rev-list -n "$depth" "origin/$MAIN" | while read -r c; do
    p=$(git rev-parse "$c^" 2>/dev/null) || continue
    content_hash_cached "$p" "$c"
  done | sort -u > "$MAIN_IDX"
}

# Walk the branch tip-first; the first commit whose cumulative content
# (merge-base..C) is found in main is the join point. Echoes the number of
# commits sitting after that join point (0 = fully merged), -1 if no join point
# is found within WALK_DEPTH, or -2 if the branch is past the evaluation cap and
# the content walk was never run.
#
# PR checked FIRST — it's authoritative and one API call (batched, see
# fetch_pr_merges), versus walking potentially hundreds of commits. The
# content walk is the fallback, against the shared MAIN_IDX built once
# up front by build_shared_main_index — no per-branch walk of main at all.
commits_not_in_main() (
  branch=$1
  base=$(git merge-base "$branch" "origin/$MAIN" 2>/dev/null) || { echo -1; return; }
  # Fully contained in main (0 unique commits — includes a branch sitting at main).
  git merge-base --is-ancestor "$branch" "origin/$MAIN" && { echo 0; return; }

  pr_mc=$(pr_merge_commit "$branch")
  if [ -n "$pr_mc" ] && ref_exists "$pr_mc"; then
    pr_join=$(git merge-base "$pr_mc" "origin/$MAIN" 2>/dev/null)
    if [ -n "$pr_join" ] && git merge-base --is-ancestor "$pr_join" "origin/$MAIN" 2>/dev/null; then
      i=0
      for c in $(git rev-list -n "$WALK_DEPTH" "$base..$branch"); do
        [ "$c" = "$pr_join" ] && { echo "$i"; return; }
        i=$((i + 1))
      done
      # PR merged, but its merge commit isn't among the branch's own recent
      # tip commits (e.g. squashed) — trust the PR: fully merged.
      echo 0; return
    fi
  fi

  # Cheap checks done and unresolved; only the expensive one is left.
  branch_beyond_cap "$branch" && { echo -2; return; }

  # Only WALK_DEPTH diffs against the branch's OWN history, tip-first, each
  # checked against the shared index built once for the whole run.
  i=0
  for c in $(git rev-list -n "$WALK_DEPTH" "$base..$branch"); do
    h=$(content_hash_cached "$base" "$c")
    if [ -s "$MAIN_IDX" ] && grep -qxF "$h" "$MAIN_IDX"; then
      echo "$i"; return
    fi
    i=$((i + 1))
  done
  echo -1
)

# ── the gone indicator (cross-check only) ───────────────────────────────────

branch_has_upstream() { git config --get "branch.$1.remote" >/dev/null; }

# Had an upstream that is now gone (remote branch deleted). No upstream at all
# is not "gone" — it is a local-only branch.
branch_upstream_gone() (
  remote=$(git config --get "branch.$1.remote") || return 1
  merge=$(git config --get "branch.$1.merge") || return 1
  ref_exists "refs/remotes/$remote/${merge#refs/heads/}" && return 1
  return 0
)

# ── worktrees ───────────────────────────────────────────────────────────────

worktree_of() {
  printf '%s\n' "$WT_MAP" | awk -F'\t' -v b="$1" '$1==b{print $2; exit}'
}

worktree_dirty() { [ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }

# The ignored files a worktree removal takes with it. Neither git status
# --porcelain nor git worktree remove counts them, so a worktree whose only
# extra content is ignored reads as clean and is removed with that content
# still inside it. Fully-ignored directories collapse to a single entry, so the
# list stays short, and it is capped regardless.
worktree_ignored() (
  all=$(git -C "$1" status --porcelain --ignored 2>/dev/null | sed -n 's/^!! //p')
  [ -z "$all" ] && return 0
  count=$(printf '%s\n' "$all" | grep -c .)
  list=$(printf '%s\n' "$all" | head -6 | awk '{ if (NR > 1) printf ", "; printf "%s", $0 } END { print "" }')
  [ "$count" -gt 6 ] && list="$list, +$((count - 6)) more"
  printf '%s ignored entries: %s\n' "$count" "$list"
)

say_ignored() {
  [ -n "$1" ] && say "     ${DIM}↳ also deletes $1${RESET}"
  return 0
}

# Reason a worktree must not be touched, or empty. Dirty ALWAYS blocks — there is
# no case where uncommitted work is worth risking. Current worktree blocks too.
worktree_block_reason() {
  [ -z "$1" ] && return 0
  [ "$1" = "$CUR_WT" ] && { echo "the worktree you are in"; return 0; }
  worktree_dirty "$1" && { echo "worktree has uncommitted changes"; return 0; }
  return 0
}

# Remove worktree first, then branch. Always -D, because the caller has already
# proved the branch tip is reachable from origin/$MAIN and that is the guarantee
# that matters. Plain -d checks something else: the branch's upstream if that ref
# still resolves, and otherwise HEAD. With the remote branch gone it falls back to
# whichever worktree you happen to be standing in, so it refuses branches that are
# provably safe.
remove_branch() (
  branch=$1 wt=$2
  if [ -n "$wt" ]; then
    git worktree remove "$wt" >/dev/null 2>&1 || { echo "worktree remove failed"; return 1; }
  fi
  git branch -D "$branch" >/dev/null 2>&1 || { echo "branch delete failed"; return 1; }
  echo removed
  return 0
)

# ── the single pass ─────────────────────────────────────────────────────────

process_branch() {
  local branch=$1 wt ahead last meta not_in_main gone noun2 icon desc note outcome

  [ "$branch" = "$MAIN" ] && return 0
  wt=$(worktree_of "$branch")

  ahead=$(git rev-list --count "origin/$MAIN..$branch" 2>/dev/null || echo '?')
  last=$(git log -1 --format=%cr "$branch" 2>/dev/null)
  # Flag anything a week or older — weeks/months/years are always old; "N
  # days ago" only counts once N reaches 7 (git shows day-granularity up to
  # ~13 days before switching to weeks). GREEN, not a warning colour: a
  # branch untouched this long is a signal it's likely safe to clean up,
  # not a signal to worry about it.
  age_color="$DIM"
  case "$last" in
    *' week'*|*' month'*|*' year'*) age_color="$GREEN" ;;
    *' day'*)
      days_num=$(printf '%s' "$last" | awk '{print $1}')
      case "$days_num" in ''|*[!0-9]*) ;; *) [ "$days_num" -ge 7 ] && age_color="$GREEN" ;; esac
      ;;
  esac
  # The commit count stays full-brightness (not dimmed) — it's the number
  # that actually matters when deciding whether a branch is worth a look.
  meta="${DIM}[${RESET}$ahead ahead${DIM}, ${RESET}${age_color}${last}${RESET}${DIM}]${RESET}"

  # Verdict (content) and indicator (gone) computed independently.
  not_in_main=$(commits_not_in_main "$branch")
  gone=false; branch_upstream_gone "$branch" && gone=true
  [ "$not_in_main" -gt 1 ] && noun2=commits || noun2=commit

  if [ "$not_in_main" = 0 ]; then
    if [ "$ahead" = 0 ]; then
      # Never diverged from main — NOT a squash-merge detection, just a
      # branch identical to main. Git's own ancestor check already knows
      # this on its own; a different class and a different flag.
      icon="${BLUE}${EMPTYICON}${RESET}"
      desc='never diverged from main'
      do_delete "$branch" "$wt" "$icon" "$desc" "$meta" "$APPLY_EMPTY" '--empty' 'EMPTY_COUNT'
      return 0
    fi
    # Fully in main — the squash-merge delete case.
    icon="${GREEN}${OK}${RESET}"
    if [ "$gone" = true ]; then
      desc='merged'
    else
      # Content is in main, but the remote branch still exists.
      desc='merged, but remote not gone — check the PR'
    fi
    do_delete "$branch" "$wt" "$icon" "$desc" "$meta" true '--apply' 'MERGED_COUNT'
    return 0
  fi

  if [ "$not_in_main" -gt 0 ]; then
    # Merged up to the join point, but N commits sit on top of it.
    note="merged, $not_in_main $noun2 on top not in main"
    [ "$gone" = true ] && note="$note [gone]"
    local block; block=$(worktree_block_reason "$wt")
    if [ -n "$block" ]; then
      say "  ${NOACCESS} $branch $meta ${DIM}($note — $block, blocked)${RESET}"
      return 0
    fi
    REVIEW_COUNT=$((REVIEW_COUNT + 1))
    [ -n "$wt" ] && note="$note, worktree"
    say "  🟡 $branch $meta ${DIM}($note)${RESET}"
    local rbase rjoin
    rbase=$(git merge-base "$branch" "origin/$MAIN")
    rjoin=$(git rev-list "$rbase..$branch" | sed -n "$((not_in_main + 1))p")
    do_rescue "$branch" "$rjoin" "$not_in_main" "$wt"
    return 0
  fi

  # Beyond the cap: the cheap checks came back unresolved and the content walk
  # was not run, so nothing is known either way. Not folded into unmerged, and
  # not offered to --gone, which means 'searched and not found', not 'not
  # searched'.
  if [ "$not_in_main" = -2 ]; then
    INCONCLUSIVE_COUNT=$((INCONCLUSIVE_COUNT + 1))
    note="$(distance_from_main "$branch") behind, not evaluated"
    [ "$gone" = true ] && note="$note [gone]"
    [ -n "$wt" ] && note="$note, worktree"
    say "  ${YELLOW}${UNKNOWN}${RESET} $branch $meta ${DIM}($note — run --old)${RESET}"
    return 0
  fi

  # not_in_main == -1: content not found in main.
  if [ "$gone" = true ]; then
    # Indicator says merged (remote deleted), content cannot confirm it.
    icon="${RED}${WARN}${RESET}"; desc='gone, but content not found in main'
    do_delete "$branch" "$wt" "$icon" "$desc" "$meta" "$APPLY_GONE" '--gone' 'SUSPECT_COUNT'
    return 0
  fi

  # Plain unmerged work.
  HIDDEN_COUNT=$((HIDDEN_COUNT + 1))
  if [ "$SHOW_ALL" = true ]; then
    note='unmerged'; branch_has_upstream "$branch" || note='unmerged, local-only'
    [ -n "$wt" ] && note="$note, worktree"
    say "  ${DIM}${KEEP} $branch${RESET} $meta ${DIM}($note)${RESET}"
  fi
}

# Print, gate on worktree safety, and record the action when this class is
# selected AND --apply is given. Nothing is deleted here: the pass decides and
# prints, run_plan carries out what was printed.

# Append one action to the plan. Fields are tab separated and never empty ('-'
# stands in for an absent worktree or an unused rescue field), because tab is
# IFS whitespace and consecutive tabs would otherwise collapse into one.
plan_add() {
  PLAN="${PLAN}$1${TAB}$2${TAB}$3${TAB}$4${TAB}$5
"
}

do_delete() {
  local branch=$1 wt=$2 icon=$3 desc=$4 meta=$5 flag_set=$6 flag=$7 class=${8:-} what block ignored

  block=$(worktree_block_reason "$wt")
  if [ -n "$block" ]; then
    say "  ${NOACCESS} $branch $meta ${DIM}($desc — $block, blocked)${RESET}"; return 0
  fi

  case "$class" in
    MERGED_COUNT) MERGED_COUNT=$((MERGED_COUNT + 1)) ;;
    EMPTY_COUNT) EMPTY_COUNT=$((EMPTY_COUNT + 1)) ;;
    SUSPECT_COUNT) SUSPECT_COUNT=$((SUSPECT_COUNT + 1)) ;;
  esac

  what='delete branch'
  ignored=''
  if [ -n "$wt" ]; then
    what='remove worktree + branch'
    ignored=$(worktree_ignored "$wt")
  fi

  if [ "$flag_set" != true ]; then
    say "  $icon $branch $meta ${DIM}($desc — would $what, run $flag)${RESET}"
    say_ignored "$ignored"
    return 0
  fi

  if [ "$APPLY" != true ]; then
    # This class's own flag is already set (flag_set passed the check above) —
    # --apply is the only thing standing between this branch and removal.
    say "  ${RED}${WOULDREMOVE}${RESET} $branch $meta ${DIM}($desc — would $what, run --apply)${RESET}"
    say_ignored "$ignored"
    return 0
  fi

  plan_add delete "$branch" - - "${wt:--}"
  say "  ${RED}${WOULDREMOVE}${RESET} $branch $meta ${DIM}($desc — will $what)${RESET}"
  say_ignored "$ignored"
}

# ── rescue (move the stray commits off, then drop the original) ──────────────

# Replay the stray commits (join..branch) onto a new branch rescue/<branch>, then
# delete the original. The replay happens in an isolated scratch worktree, so a
# failed attempt never touches your branches or checkouts. Try main first; on
# conflict fall back to the PR merge commit; if both conflict, leave it for you.
#
# The gates are decisions, so they stay in the pass. run_rescue is the doing
# half and runs from the plan.
do_rescue() {
  local branch=$1 join=$2 n=$3 wt=$4 dst="rescue/$branch" block ignored

  git show-ref --verify --quiet "refs/heads/$dst" && { say "     ${DIM}↳ rescue skipped — $dst already exists${RESET}"; return 0; }
  block=$(worktree_block_reason "$wt")
  [ -n "$block" ] && { say "     ${NOACCESS} rescue blocked — $block"; return 0; }
  ignored=''
  [ -n "$wt" ] && ignored=$(worktree_ignored "$wt")
  if [ "$RESCUE" != true ]; then
    say "     ${DIM}↳ would rescue $n onto main → $dst   (run --rescue)${RESET}"; say_ignored "$ignored"; return 0
  fi
  if [ "$APPLY" != true ]; then
    # --rescue is already set (the check above passed) — --apply is the only
    # thing standing between this branch and actually being rescued.
    say "     ${RED}${WOULDREMOVE}${RESET} would rescue $n onto main → $dst   (run --apply)"; say_ignored "$ignored"; return 0
  fi
  plan_add rescue "$branch" "$join" "$n" "${wt:--}"
  say "     ${RED}${WOULDREMOVE}${RESET} will rescue $n onto main → $dst"
  say_ignored "$ignored"
}

run_rescue() {
  local branch=$1 join=$2 n=$3 wt=$4 dst="rescue/$branch" tmp base_used pr_mc rc outcome

  tmp=$(mktemp -d) || return 1
  git worktree add -q --detach "$tmp" "origin/$MAIN" 2>/dev/null || {
    rmdir "$tmp" 2>/dev/null
    say "     ${YELLOW}↳ rescue setup failed${RESET}"; return 1; }

  base_used=main
  ( cd "$tmp" && git switch -q -c "$dst" "$branch" && git rebase -q --onto "origin/$MAIN" "$join" ) 2>/dev/null
  rc=$?
  if [ "$rc" -ne 0 ]; then
    ( cd "$tmp" && git rebase --abort >/dev/null 2>&1; git switch -q --detach 2>/dev/null; git branch -D "$dst" >/dev/null 2>&1 )
    pr_mc=$(pr_merge_commit "$branch")
    if [ -n "$pr_mc" ]; then
      base_used="PR merge ${pr_mc}"
      ( cd "$tmp" && git switch -q -c "$dst" "$branch" && git rebase -q --onto "$pr_mc" "$join" ) 2>/dev/null
      rc=$?
      [ "$rc" -ne 0 ] && ( cd "$tmp" && git rebase --abort >/dev/null 2>&1; git switch -q --detach 2>/dev/null; git branch -D "$dst" >/dev/null 2>&1 )
    fi
  fi

  git worktree remove "$tmp" >/dev/null 2>&1 || git worktree prune >/dev/null 2>&1

  if [ "$rc" -ne 0 ]; then
    say "     ${YELLOW}↳ conflicts on both bases — left for manual${RESET}"; return 1
  fi

  # Stray is now preserved on $dst; the original's merged part is in main.
  outcome=$(remove_branch "$branch" "$wt")
  if [ "$outcome" = removed ]; then
    RESCUED_COUNT=$((RESCUED_COUNT + 1))
    say "     ${GREEN}↳ rescued $n → $dst (onto $base_used); original removed${RESET}"
  else
    say "     ${YELLOW}↳ rescued to $dst, but original $outcome${RESET}"
  fi
}

# ── execute (do exactly what the plan said) ─────────────────────────────

# Decides nothing. Every choice was made in the pass above and is already on
# screen; this walks the recorded actions and carries them out in order.
run_plan() {
  local action branch join n wt outcome
  while IFS="$TAB" read -r action branch join n wt; do
    [ -z "$action" ] && continue
    [ "$wt" = - ] && wt=''
    case "$action" in
      delete)
        outcome=$(remove_branch "$branch" "$wt")
        if [ "$outcome" = removed ]; then
          REMOVED_COUNT=$((REMOVED_COUNT + 1))
          say "  ${GREEN}${OK}${RESET} $branch removed"
        else
          say "  ${YELLOW}${WARN}${RESET}$branch: $outcome, skipped"
        fi
        ;;
      rescue)
        say "  $branch"
        run_rescue "$branch" "$join" "$n" "$wt"
        ;;
    esac
  done <<EOF
$PLAN
EOF
}

# ── argument parsing ────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Usage: git cleanup [options]

Deletes local branches (and their worktrees) whose commits are already in the
main branch. The merge check is the verdict; 'gone' (remote branch deleted) is
only an indicator, surfaced when it disagrees with the content.

  merged (0 commits on top)  → deleted by --apply
  merged + N commits on top  → rescued (stray commits moved off), then deleted, by --rescue
  gone but content not found → warned; deleted by --gone if you trust it
  unmerged                   → kept
  too far behind             → inconclusive, not evaluated; evaluated by --old

Options:
  --apply          delete the fully-merged branches (and their worktrees)
  --rescue         for 'merged + N on top' branches, replay the N stray commits
                   onto main as rescue/<branch>, then delete the original
                   (falls back to the PR merge commit; skips on conflict)
  --gone           also delete 'gone' branches whose content can't be found
                   (trusting the remote-deleted indicator)
  --empty          also delete branches that never diverged from main (0
                   commits ahead) — not a squash-merge detection
  --branch BRANCH  check (and, with the other flags, act on) only this
                   branch, instead of walking every local branch — repeat
                   the flag to filter to several
  -a, --all        also list the plain unmerged / idle branches (hidden by default)
  --depth N        commits to walk back from each tip for the join point (default 5)
  --old            also evaluate branches left inconclusive by the cap: more
                   than $MAX_DISTANCE commits behind main AND untouched for
                   $MAX_AGE_DAYS days
  -b, --base REF   compare against REF instead of the detected main branch
  --no-fetch       skip the initial 'git fetch --prune origin'
  -v, --verbose    log progress to stderr
  -h, --help       show this help

Default (no flag) is a dry-run report. A branch whose worktree is dirty, or that
you are standing in, is never touched.

Azure DevOps repos read git config 'cleanup.subscription' for a subscription in
the org's tenant, which is what resolves the identity to authenticate as. Set it
beside user.email in the includeIf'd file for the org. Without it the PR check is
skipped rather than run under whichever account happens to be default.

Where two orgs need different identities on the same subscription, add
'cleanup.azconfig' pointing at a private az profile directory. One profile holds
one login per subscription, so without this the second login evicts the first.
EOF
}

APPLY=false; APPLY_GONE=false; APPLY_EMPTY=false; RESCUE=false; SHOW_ALL=false; BASE_OVERRIDE=''; NO_FETCH=false; VERBOSE=false; WALK_DEPTH=5; ONLY_BRANCHES=''; EVALUATE_OLD=false

# The evaluation cap. Both must be exceeded before a branch is left unevaluated.
MAX_DISTANCE=100; MAX_AGE_DAYS=30

# The Azure DevOps resource ID: the token audience az rest has to ask for.
ADO_RESOURCE=499b84ac-1321-427f-aa17-267ca6975798

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=true ;;
    --rescue) RESCUE=true ;;
    --gone) APPLY_GONE=true ;;
    --empty) APPLY_EMPTY=true ;;
    --branch) shift; [ $# -gt 0 ] || { echo "Error: --branch requires a branch name" >&2; exit 1; }; ONLY_BRANCHES="$ONLY_BRANCHES $1" ;;
    -a|--all) SHOW_ALL=true ;;
    --depth) shift; [ $# -gt 0 ] || { echo "Error: --depth requires a number" >&2; exit 1; }; WALK_DEPTH=$1 ;;
    --old) EVALUATE_OLD=true ;;
    -b|--base) shift; [ $# -gt 0 ] || { echo "Error: --base requires a branch name" >&2; exit 1; }; BASE_OVERRIDE=$1 ;;
    --no-fetch) NO_FETCH=true ;;
    -v|--verbose) VERBOSE=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

ensure_in_git_repository
command -v shasum >/dev/null 2>&1 || { echo "Error: shasum not found (needed for the content hash)" >&2; exit 1; }
CACHE_DIR="$(git rev-parse --git-dir)/cleanup-cache"
mkdir -p "$CACHE_DIR"
NOW=$(date +%s)
TAB=$(printf '\t')
MAIN=$(get_main_branch)
ref_exists "origin/$MAIN" || { echo "Error: origin/$MAIN does not exist (fetch origin, or pass -b <branch>)" >&2; exit 1; }

if [ "$EVALUATE_OLD" = true ]; then
  CAP_NOTE='cap off (--old)'
else
  CAP_NOTE="cap ${MAX_DISTANCE} behind + ${MAX_AGE_DAYS}d"
fi
printf '%b\n' "${BOLD}git cleanup${RESET} ${DIM}$MAIN · $(git for-each-ref --format='%(refname:short)' refs/heads/ | grep -c .) branches · $CAP_NOTE${RESET}"

step 'fetch origin ...'
fetch_origin
if [ "$NO_FETCH" = true ]; then step_done 'skipped (--no-fetch)'; else step_done 'done'; fi

step 'merged PRs ...'
fetch_pr_merges
step_done "$(printf '%s' "$PR_MERGE_TABLE" | grep -c .) found ($PR_SOURCE)"
[ -n "$PR_HINT" ] && say "$PR_HINT"

step 'indexing main ...'
build_shared_main_index
step_done "$(wc -l < "$MAIN_IDX" | tr -d ' ') commits"

WT_MAP=$(git worktree list --porcelain | awk '
  /^worktree /   { p = substr($0, 10) }
  /^branch refs\/heads\// { print substr($0, 19) "\t" p }
')
DETACHED=$(git worktree list --porcelain | awk '
  /^worktree /   { p = substr($0, 10) }
  /^detached/    { print p }
')
CUR_WT=$(git rev-parse --show-toplevel 2>/dev/null)

MERGED_COUNT=0; REVIEW_COUNT=0; SUSPECT_COUNT=0; EMPTY_COUNT=0; REMOVED_COUNT=0; RESCUED_COUNT=0; HIDDEN_COUNT=0; INCONCLUSIVE_COUNT=0; PLAN=''

printf '\n%b\n' "${BOLD}Branches${RESET}"
if [ -n "$ONLY_BRANCHES" ]; then
  for branch in $ONLY_BRANCHES; do
    ref_exists "refs/heads/$branch" || { echo "Error: no local branch named '$branch'" >&2; exit 1; }
  done
  for branch in $ONLY_BRANCHES; do
    process_branch "$branch"
  done
else
  for branch in $(git for-each-ref --format '%(refname:short)' refs/heads/); do
    process_branch "$branch"
  done
fi

if [ -n "$DETACHED" ]; then
  printf '\n%b\n' "${BOLD}Detached worktrees${RESET} ${DIM}(no branch — judge by hand)${RESET}"
  printf '%s\n' "$DETACHED" | while IFS= read -r p; do
    [ "$p" = "$CUR_WT" ] && continue
    say "  ${KEEP} $(basename "$p") ${DIM}($p)${RESET}"
  done
fi

printf '\n'
# Summary rule — three kinds of line, three reasons:
#  - the five category counts (merged/empty/review/suspect/inconclusive) always
#    print, zero or not: this is a fixed report card, and a line that vanishes
#    at zero is ambiguous — "nothing here" or "never checked"?
#  - the hidden/unmerged line always prints too, but its wording depends on
#    -a: with -a nothing is actually hidden, so it must say so, not repeat
#    a stale "hidden" claim.
#  - the removed/rescued line only prints under --apply: it reports what
#    this run did, not a category, and a dry run never does anything.
say "${GREEN}${OK} merged, ready to delete: $MERGED_COUNT${RESET}  ${DIM}→ --apply${RESET}"
say "${BLUE}${EMPTYICON} never diverged from main: $EMPTY_COUNT${RESET}  ${DIM}→ --empty${RESET}"
say "${DIM}${KEEP} merged with commits on top: $REVIEW_COUNT${RESET}  ${DIM}→ --rescue${RESET}"
say "${RED}${WARN}gone but content not found: $SUSPECT_COUNT${RESET}  ${DIM}→ --gone to trust${RESET}"
say "${YELLOW}${UNKNOWN}${RESET} inconclusive, too far behind: $INCONCLUSIVE_COUNT${RESET}  ${DIM}→ --old${RESET}"
if [ "$SHOW_ALL" = true ]; then
  say "${DIM}$HIDDEN_COUNT unmerged/idle shown above${RESET}"
else
  say "${DIM}$HIDDEN_COUNT unmerged/idle hidden  → -a to show${RESET}"
fi
if [ "$APPLY" != true ]; then
  say "${DIM}dry run — nothing deleted${RESET}"
elif [ -z "$PLAN" ]; then
  say "${DIM}nothing to do${RESET}"
else
  printf '\n'
  say "${BOLD}starting in 5 seconds, ctrl-c to abort${RESET}"
  sleep 5
  printf '\n'
  run_plan
  printf '\n'
  say "${DIM}removed $REMOVED_COUNT, rescued $RESCUED_COUNT this run${RESET}"
fi
