#!/bin/sh
#
# git cleanup — delete local branches (and their worktrees) whose work is
# already in the main branch.
#
# Invoked as a git subcommand: git finds this file on $PATH as `git-cleanup`,
# so `git cleanup` runs it. Default is a dry-run report; nothing is deleted
# without --apply.
#
# THE DECISION is the merge check, and only the merge check: are the branch's
# commits already in main? Walking the branch tip-first, the first commit whose
# content is found in main is where the branch joins main; anything before it is
# work not yet in main.
#
#   0 commits not in main  → fully merged     → delete (and its worktree)
#   N commits not in main  → merged + N on top → review (kept)
#   no join point found    → not merged        → keep
#
# A MERGED PULL REQUEST IS NOT THE SAME CLAIM. It answers the squash case, where
# none of the branch's commits are in main and the content walk has nothing to
# find, but it only speaks for the commits it carried. So it counts only when the
# branch tip is EXACTLY the source tip the PR merged. One commit added after the
# merge and the branch is a normal branch again, judged by content like any
# other, because that commit is in main nowhere.
#
# GONE IS ONLY AN INDICATOR. The remote branch being deleted says nothing about
# content; it is a cross-check against the verdict, and only matters when the
# two disagree:
#
#   merged  but NOT gone  → warn: content is in main yet the remote still exists
#   gone    but NOT merged → warn: remote deleted (likely squashed) yet its
#                            content cannot be found — look by hand
#
# gone never changes the verdict. Strip it away and the merge check reads the
# same.
#
# A DETACHED WORKTREE has no branch to speak for it, so the commit it is parked
# on is the subject, and five facts about that commit decide it:
#
#   uncommitted  the worktree holds changes that exist nowhere else
#   in main      the commit's work is in the trunk
#   merged PR    a merged pull request carries the commit
#   open PR      an open pull request carries the commit
#   on a ref     a branch, remote branch or tag contains the commit
#
# Those collapse to two questions. FINISHED is in main or merged PR: the work it
# was made for has landed, so the worktree has no future. LIVE is uncommitted,
# on a ref, or open PR: something there is still going on.
#
#   uncommitted → keep      finished → remove
#   live        → keep      neither  → unsure, said plainly rather than guessed
#
# ON A REF IS A KEEP, NEVER A REMOVE. A branch still holding the commit says the
# work is not finished, and a worktree of unfinished work is one you may still
# want, whether you made it an hour ago or a year ago. Age says nothing here and
# is not consulted.

set -u

# Everything shared with the other git commands here lives in ../lib. See its
# header for how the path resolves through the install symlinks.
DIR=$(cd "$(dirname "$0")" && pwd)
TOOL='git cleanup'
# SCRIPTDIR makes shellcheck resolve the path below against this file rather
# than against whatever directory it happens to be run from.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/git-common.sh
. "$DIR/../lib/git-common.sh"

# The Azure DevOps resource ID: the token audience az rest has to ask for.
ADO_RESOURCE=499b84ac-1321-427f-aa17-267ca6975798

# ── the single pass ─────────────────────────────────────────────────────────

process_branch() {
  local branch=$1 wt ahead last meta not_in_main gone noun2 icon desc note outcome

  [ "$branch" = "$MAIN" ] && return 0
  wt=$(worktree_of "$branch")

  ahead=$(git rev-list --count "origin/$MAIN..$branch" 2>/dev/null || echo '?')
  last=$(git log -1 --format=%cr "$branch" 2>/dev/null)
  # The commit count stays full-brightness (not dimmed) — it's the number
  # that actually matters when deciding whether a branch is worth a look.
  meta="${DIM}[${RESET}$ahead ahead${DIM}, ${RESET}$(age_colour "$last")${last}${RESET}${DIM}]${RESET}"

  # Verdict (content) and indicator (gone) computed independently.
  not_in_main=$(commits_not_in_main "$branch")
  gone=false; branch_upstream_gone "$branch" && gone=true
  [ "$not_in_main" -gt 1 ] && noun2=commits || noun2=commit

  if [ "$not_in_main" = 0 ]; then
    if [ "$ahead" = 0 ]; then
      # Never diverged from main — NOT a squash-merge detection, just a
      # branch identical to main. Git's own ancestor check already knows
      # this on its own; a different class and a different flag.
      icon="${BLUE}${EMPTYICON}${RESET}"
      desc='never diverged from main'
      do_delete "$branch" "$wt" "$icon" "$desc" "$meta" "$APPLY_EMPTY" '--empty' 'EMPTY_COUNT'
      return 0
    fi
    # Fully in main — the squash-merge delete case.
    icon="${GREEN}${OK}${RESET}"
    if [ "$gone" = true ]; then
      desc='merged'
    else
      # Content is in main, but the remote branch still exists.
      desc='merged, but remote not gone — check the PR'
    fi
    do_delete "$branch" "$wt" "$icon" "$desc" "$meta" true '--apply' 'MERGED_COUNT'
    return 0
  fi

  if [ "$not_in_main" -gt 0 ]; then
    # Merged up to the join point, but N commits sit on top of it.
    note="merged, $not_in_main $noun2 on top not in main"
    [ "$gone" = true ] && note="$note [gone]"
    local block; block=$(worktree_block_reason "$wt")
    if [ -n "$block" ]; then
      say "  ${NOACCESS} $branch $meta ${DIM}($note — $block, blocked)${RESET}"
      return 0
    fi
    REVIEW_COUNT=$((REVIEW_COUNT + 1))
    [ -n "$wt" ] && note="$note, worktree"
    say "  🟡 $branch $meta ${DIM}($note)${RESET}"
    local rbase rjoin
    rbase=$(git merge-base "$branch" "origin/$MAIN")
    rjoin=$(git rev-list "$rbase..$branch" | sed -n "$((not_in_main + 1))p")
    do_rescue "$branch" "$rjoin" "$not_in_main" "$wt"
    return 0
  fi

  # Beyond the cap: the cheap checks came back unresolved and the content walk
  # was not run, so nothing is known either way. Not folded into unmerged, and
  # not offered to --gone, which means 'searched and not found', not 'not
  # searched'.
  if [ "$not_in_main" = -2 ]; then
    INCONCLUSIVE_COUNT=$((INCONCLUSIVE_COUNT + 1))
    note="$(distance_from_main "$branch") behind, not evaluated"
    [ "$gone" = true ] && note="$note [gone]"
    [ -n "$wt" ] && note="$note, worktree"
    say "  ${YELLOW}${UNKNOWN}${RESET} $branch $meta ${DIM}($note — run --old)${RESET}"
    return 0
  fi

  # not_in_main == -1: content not found in main.
  if [ "$gone" = true ]; then
    # Indicator says merged (remote deleted), content cannot confirm it.
    icon="${RED}${WARN}${RESET}"; desc='gone, but content not found in main'
    do_delete "$branch" "$wt" "$icon" "$desc" "$meta" "$APPLY_GONE" '--gone' 'SUSPECT_COUNT'
    return 0
  fi

  # Plain unmerged work.
  HIDDEN_COUNT=$((HIDDEN_COUNT + 1))
  if [ "$SHOW_ALL" = true ]; then
    note='unmerged'; branch_has_upstream "$branch" || note='unmerged, local-only'
    [ -n "$wt" ] && note="$note, worktree"
    say "  ${DIM}${KEEP} $branch${RESET} $meta ${DIM}($note)${RESET}"
  fi
}

say_keeping() { say "  ${DIM}${KEEP} $1${RESET} $2 ${DIM}($3 — keeping)${RESET}"; }

# The five facts, in the order that decides. Each rule that fires is the whole
# reason, and it is the reason printed.
process_detached() {
  local wt=$1 head=$2 name short ahead last meta pr ref

  name=$(basename "$wt")
  short=$(git rev-parse --short "$head" 2>/dev/null)
  ahead=$(git rev-list --count "origin/$MAIN..$head" 2>/dev/null || echo '?')
  last=$(git log -1 --format=%cr "$head" 2>/dev/null)
  meta="${DIM}[${RESET}$short${DIM}, ${RESET}$ahead ahead${DIM}, ${RESET}$(age_colour "$last")${last}${RESET}${DIM}]${RESET}"

  # Uncommitted, or the worktree you are standing in.
  ref=$(worktree_block_reason "$wt")
  [ -n "$ref" ] && { say_keeping "$name" "$meta" "$ref"; return 0; }

  # Finished: the trunk has the work, by content or by a merged pull request.
  if [ "$(commits_not_in_main "$head")" = 0 ]; then
    do_delete_worktree "$wt" "$name" 'work already in main' "$meta"; return 0
  fi
  pr=$(detached_pr "$head" merged)
  [ -n "$pr" ] && { do_delete_worktree "$wt" "$name" "merged in $pr" "$meta"; return 0; }

  # Live: a branch still holds it, or a pull request is still open on it.
  ref=$(commit_on_ref "$head")
  [ -n "$ref" ] && { say_keeping "$name" "$meta" "on $ref"; return 0; }
  pr=$(detached_pr "$head" open)
  [ -n "$pr" ] && { say_keeping "$name" "$meta" "$pr is open"; return 0; }

  # Nothing claims it either way.
  UNSURE_COUNT=$((UNSURE_COUNT + 1))
  pr=$(detached_pr "$head" closed)
  [ -n "$pr" ] && pr="$pr closed without merging" || pr='on no branch, in no pull request'
  say "  ${YELLOW}${UNKNOWN}${RESET} $name $meta ${DIM}($pr — unsure)${RESET}"
}

# Print, gate on worktree safety, and record the action when this class is
# selected AND --apply is given. Nothing is deleted here: the pass decides and
# prints, run_plan carries out what was printed.


do_delete() {
  local branch=$1 wt=$2 icon=$3 desc=$4 meta=$5 flag_set=$6 flag=$7 class=${8:-} what block ignored

  block=$(worktree_block_reason "$wt")
  if [ -n "$block" ]; then
    say "  ${NOACCESS} $branch $meta ${DIM}($desc — $block, blocked)${RESET}"; return 0
  fi

  case "$class" in
    MERGED_COUNT) MERGED_COUNT=$((MERGED_COUNT + 1)) ;;
    EMPTY_COUNT) EMPTY_COUNT=$((EMPTY_COUNT + 1)) ;;
    SUSPECT_COUNT) SUSPECT_COUNT=$((SUSPECT_COUNT + 1)) ;;
  esac

  what='delete branch'
  ignored=''
  if [ -n "$wt" ]; then
    what='remove worktree + branch'
    ignored=$(worktree_ignored "$wt")
  fi

  if [ "$flag_set" != true ]; then
    say "  $icon $branch $meta ${DIM}($desc — would $what, run $flag)${RESET}"
    say_ignored "$ignored"
    return 0
  fi

  if [ "$APPLY" != true ]; then
    # This class's own flag is already set (flag_set passed the check above) —
    # --apply is the only thing standing between this branch and removal.
    say "  ${RED}${WOULDREMOVE}${RESET} $branch $meta ${DIM}($desc — would $what, run --apply)${RESET}"
    say_ignored "$ignored"
    return 0
  fi

  plan_add delete "$branch" - - "${wt:--}"
  say "  ${RED}${WOULDREMOVE}${RESET} $branch $meta ${DIM}($desc — will $what)${RESET}"
  say_ignored "$ignored"
}

# The branchless twin of do_delete: same two gates, but there is only a worktree
# to take away, and the caller has already cleared the keep rules.
do_delete_worktree() {
  local wt=$1 name=$2 desc=$3 meta=$4 ignored

  DETACHED_COUNT=$((DETACHED_COUNT + 1))
  ignored=$(worktree_ignored "$wt")

  if [ "$APPLY_DETACHED" != true ]; then
    say "  ${GREEN}${OK}${RESET} $name $meta ${DIM}($desc — would remove worktree, run --detached)${RESET}"
    say_ignored "$ignored"
    return 0
  fi

  if [ "$APPLY" != true ]; then
    say "  ${RED}${WOULDREMOVE}${RESET} $name $meta ${DIM}($desc — would remove worktree, run --apply)${RESET}"
    say_ignored "$ignored"
    return 0
  fi

  plan_add detached "$name" - - "$wt"
  say "  ${RED}${WOULDREMOVE}${RESET} $name $meta ${DIM}($desc — will remove worktree)${RESET}"
  say_ignored "$ignored"
}

# ── rescue (move the stray commits off, then drop the original) ──────────────

# Replay the stray commits (join..branch) onto a new branch rescue/<branch>, then
# delete the original. The replay happens in an isolated scratch worktree, so a
# failed attempt never touches your branches or checkouts. Try main first; on
# conflict fall back to the PR merge commit; if both conflict, leave it for you.
#
# The gates are decisions, so they stay in the pass. run_rescue is the doing
# half and runs from the plan.
do_rescue() {
  local branch=$1 join=$2 n=$3 wt=$4 dst="rescue/$branch" block ignored

  git show-ref --verify --quiet "refs/heads/$dst" && { say "     ${DIM}↳ rescue skipped — $dst already exists${RESET}"; return 0; }
  block=$(worktree_block_reason "$wt")
  [ -n "$block" ] && { say "     ${NOACCESS} rescue blocked — $block"; return 0; }
  ignored=''
  [ -n "$wt" ] && ignored=$(worktree_ignored "$wt")
  if [ "$RESCUE" != true ]; then
    say "     ${DIM}↳ would rescue $n onto main → $dst   (run --rescue)${RESET}"; say_ignored "$ignored"; return 0
  fi
  if [ "$APPLY" != true ]; then
    # --rescue is already set (the check above passed) — --apply is the only
    # thing standing between this branch and actually being rescued.
    say "     ${RED}${WOULDREMOVE}${RESET} would rescue $n onto main → $dst   (run --apply)"; say_ignored "$ignored"; return 0
  fi
  plan_add rescue "$branch" "$join" "$n" "${wt:--}"
  say "     ${RED}${WOULDREMOVE}${RESET} will rescue $n onto main → $dst"
  say_ignored "$ignored"
}


# ── argument parsing ────────────────────────────────────────────────────────

usage() {
  cat <<EOF
Usage: git cleanup [options]

Deletes local branches (and their worktrees) whose commits are already in the
main branch. The merge check is the verdict; 'gone' (remote branch deleted) is
only an indicator, surfaced when it disagrees with the content.

A worktree with no branch on it is judged on the commit it is parked on: removed
when that work has landed, kept when anything says the work is still going, and
reported as unsure when neither is true. Whether a branch still holds the commit
is a reason to keep it, never a reason to remove it, and its age is not used.

  merged (0 commits on top)  → deleted by --apply
  merged + N commits on top  → rescued (stray commits moved off), then deleted, by --rescue
  gone but content not found → warned; deleted by --gone if you trust it
  unmerged                   → kept
  too far behind             → inconclusive, not evaluated; evaluated by --old
  detached, work landed      → removed by --detached
  detached, work still going → kept
  detached, neither          → unsure, reported and kept

Options:
  --apply          delete the fully-merged branches (and their worktrees)
  --rescue         for 'merged + N on top' branches, replay the N stray commits
                   onto main as rescue/<branch>, then delete the original
                   (falls back to the PR merge commit; skips on conflict)
  --gone           also delete 'gone' branches whose content can't be found
                   (trusting the remote-deleted indicator)
  --empty          also delete branches that never diverged from main (0
                   commits ahead) — not a squash-merge detection
  --detached       also remove worktrees with no branch on them, whose commit is
                   in main or carried by a merged pull request
  --branch BRANCH  check (and, with the other flags, act on) only this
                   branch, instead of walking every local branch — repeat
                   the flag to filter to several
  -a, --all        also list the plain unmerged / idle branches (hidden by default)
  --depth N        commits to walk back from each tip for the join point (default 5)
  --old            also evaluate branches left inconclusive by the cap: more
                   than $MAX_DISTANCE commits behind main AND untouched for
                   $MAX_AGE_DAYS days
  -b, --base REF   compare against REF instead of the detected main branch
  --no-fetch       skip the initial 'git fetch --prune origin'
  -v, --verbose    log progress to stderr
  -h, --help       show this help

Default (no flag) is a dry-run report. A branch whose worktree is dirty, or that
you are standing in, is never touched, and the same holds for a detached one.

Azure DevOps repos read git config 'cleanup.subscription' for a subscription in
the org's tenant, which is what resolves the identity to authenticate as. Set it
beside user.email in the includeIf'd file for the org. Without it the PR check is
skipped rather than run under whichever account happens to be default.

Where two orgs need different identities on the same subscription, add
'cleanup.azconfig' pointing at a private az profile directory. One profile holds
one login per subscription, so without this the second login evicts the first.
EOF
}

APPLY=false; APPLY_GONE=false; APPLY_EMPTY=false; APPLY_DETACHED=false; RESCUE=false; SHOW_ALL=false; BASE_OVERRIDE=''; NO_FETCH=false; VERBOSE=false; WALK_DEPTH=5; ONLY_BRANCHES=''; EVALUATE_OLD=false

# The evaluation cap. Both must be exceeded before a branch is left unevaluated.
MAX_DISTANCE=100; MAX_AGE_DAYS=30

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=true ;;
    --rescue) RESCUE=true ;;
    --gone) APPLY_GONE=true ;;
    --empty) APPLY_EMPTY=true ;;
    --detached) APPLY_DETACHED=true ;;
    --branch) shift; [ $# -gt 0 ] || { echo "Error: --branch requires a branch name" >&2; exit 1; }; ONLY_BRANCHES="$ONLY_BRANCHES $1" ;;
    -a|--all) SHOW_ALL=true ;;
    --depth) shift; [ $# -gt 0 ] || { echo "Error: --depth requires a number" >&2; exit 1; }; WALK_DEPTH=$1 ;;
    --old) EVALUATE_OLD=true ;;
    -b|--base) shift; [ $# -gt 0 ] || { echo "Error: --base requires a branch name" >&2; exit 1; }; BASE_OVERRIDE=$1 ;;
    --no-fetch) NO_FETCH=true ;;
    -v|--verbose) VERBOSE=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

ensure_in_git_repository
command -v shasum >/dev/null 2>&1 || { echo "Error: shasum not found (needed for the content hash)" >&2; exit 1; }

# Run from the main working tree, always. git refuses to remove that one, so
# whatever this run deletes, it is never standing on it. Without this, removing
# the worktree you launched from unlinks the directory the process is sitting in
# and every git call for the rest of the run resolves from a path that is gone.
# The first porcelain entry is the main working tree by definition.
MAIN_WT=$(git worktree list --porcelain | awk '/^worktree /{print substr($0, 10); exit}')
[ -n "$MAIN_WT" ] || { echo "Error: cannot find the main working tree" >&2; exit 1; }
cd "$MAIN_WT" || exit 1

CACHE_DIR="$(git rev-parse --git-dir)/cleanup-cache"
mkdir -p "$CACHE_DIR"
NOW=$(date +%s)
TAB=$(printf '\t')
MAIN=$(get_main_branch)
ref_exists "origin/$MAIN" || { echo "Error: origin/$MAIN does not exist (fetch origin, or pass -b <branch>)" >&2; exit 1; }

if [ "$EVALUATE_OLD" = true ]; then
  CAP_NOTE='cap off (--old)'
else
  CAP_NOTE="cap ${MAX_DISTANCE} behind + ${MAX_AGE_DAYS}d"
fi
printf '%b\n' "${BOLD}git cleanup${RESET} ${DIM}$MAIN · $(git for-each-ref --format='%(refname:short)' refs/heads/ | grep -c .) branches · $CAP_NOTE${RESET}"

step 'fetch origin ...'
fetch_origin
if [ "$NO_FETCH" = true ]; then step_done 'skipped (--no-fetch)'; else step_done 'done'; fi

step 'merged PRs ...'
fetch_pr_merges
step_done "$(printf '%s' "$PR_MERGE_TABLE" | grep -c .) found ($PR_SOURCE)"
[ -n "$PR_HINT" ] && say "$PR_HINT"

WT_MAP=$(git worktree list --porcelain | awk '
  /^worktree /   { p = substr($0, 10) }
  /^branch refs\/heads\// { print substr($0, 19) "\t" p }
')
# HEAD comes before the branch/detached line of each entry, so the sha is in
# hand by the time the kind is known.
DETACHED=$(git worktree list --porcelain | awk '
  /^worktree /   { p = substr($0, 10) }
  /^HEAD /       { h = substr($0, 6) }
  /^detached/    { print h "\t" p }
')

# After DETACHED: the index depth is sized for the detached heads too.
step 'indexing main ...'
build_shared_main_index
step_done "$(wc -l < "$MAIN_IDX" | tr -d ' ') commits"

DETACHED_PR_TABLE=''
if [ -n "$DETACHED" ] && [ -z "$ONLY_BRANCHES" ]; then
  step 'detached worktree PRs ...'
  fetch_detached_prs
  step_done "$(printf '%s' "$DETACHED_PR_TABLE" | grep -c .) found"
fi

MERGED_COUNT=0; REVIEW_COUNT=0; SUSPECT_COUNT=0; EMPTY_COUNT=0; DETACHED_COUNT=0; UNSURE_COUNT=0; REMOVED_COUNT=0; RESCUED_COUNT=0; HIDDEN_COUNT=0; INCONCLUSIVE_COUNT=0; PLAN=''

printf '\n%b\n' "${BOLD}Branches${RESET}"
if [ -n "$ONLY_BRANCHES" ]; then
  for branch in $ONLY_BRANCHES; do
    ref_exists "refs/heads/$branch" || { echo "Error: no local branch named '$branch'" >&2; exit 1; }
  done
  for branch in $ONLY_BRANCHES; do
    process_branch "$branch"
  done
else
  for branch in $(git for-each-ref --format '%(refname:short)' refs/heads/); do
    process_branch "$branch"
  done
fi

# Not a pipeline: the loop counts and appends to the plan, and a pipeline would
# run it in a subshell and throw both away when it ended.
if [ -n "$DETACHED" ] && [ -z "$ONLY_BRANCHES" ]; then
  printf '\n%b\n' "${BOLD}Detached worktrees${RESET}"
  while IFS="$TAB" read -r head p; do
    [ -z "$head" ] && continue
    process_detached "$p" "$head"
  done <<EOF
$DETACHED
EOF
fi

printf '\n'
# Summary rule — three kinds of line, three reasons:
#  - the seven category counts always print, zero or not: this is a fixed report
#    card, and a line that vanishes at zero is ambiguous — "nothing here" or
#    "never checked"?
#  - the hidden/unmerged line always prints too, but its wording depends on
#    -a: with -a nothing is actually hidden, so it must say so, not repeat
#    a stale "hidden" claim.
#  - the removed/rescued line only prints under --apply: it reports what
#    this run did, not a category, and a dry run never does anything.
say "${GREEN}${OK} merged, ready to delete: $MERGED_COUNT${RESET}  ${DIM}→ --apply${RESET}"
say "${BLUE}${EMPTYICON} never diverged from main: $EMPTY_COUNT${RESET}  ${DIM}→ --empty${RESET}"
say "${DIM}${KEEP} merged with commits on top: $REVIEW_COUNT${RESET}  ${DIM}→ --rescue${RESET}"
say "${RED}${WARN}gone but content not found: $SUSPECT_COUNT${RESET}  ${DIM}→ --gone to trust${RESET}"
say "${YELLOW}${UNKNOWN}${RESET} inconclusive, too far behind: $INCONCLUSIVE_COUNT${RESET}  ${DIM}→ --old${RESET}"
say "${GREEN}${OK} detached worktrees, work landed: $DETACHED_COUNT${RESET}  ${DIM}→ --detached${RESET}"
say "${YELLOW}${UNKNOWN}${RESET} detached worktrees, unsure: $UNSURE_COUNT${RESET}  ${DIM}→ nothing claims them${RESET}"
if [ "$SHOW_ALL" = true ]; then
  say "${DIM}$HIDDEN_COUNT unmerged/idle shown above${RESET}"
else
  say "${DIM}$HIDDEN_COUNT unmerged/idle hidden  → -a to show${RESET}"
fi
if [ "$APPLY" != true ]; then
  say "${DIM}dry run — nothing deleted${RESET}"
elif [ -z "$PLAN" ]; then
  say "${DIM}nothing to do${RESET}"
else
  printf '\n'
  say "${BOLD}starting in 5 seconds, ctrl-c to abort${RESET}"
  sleep 5
  printf '\n'
  run_plan
  printf '\n'
  say "${DIM}removed $REMOVED_COUNT, rescued $RESCUED_COUNT this run${RESET}"
fi
