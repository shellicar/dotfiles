# Starts claude-watchdog.service 30 seconds after boot, then 5 seconds after
# each time it was last started, to within 1 second. Enabling it hooks it
# into timers.target, so it runs on every boot.

[Unit]
Description=Check for D-state claude processes

[Timer]
OnBootSec=30
OnUnitActiveSec=5s
AccuracySec=1s

[Install]
WantedBy=timers.target
