# Dependencies only macOS installs from Homebrew, on top of setup/Brewfile.
# (Broader toolchain — azure-cli, docker, etc. — goes here too if you want it.)

brew "git"        # newer than the system git
brew "coreutils"  # provides gls (the `ls` alias)
brew "vim"        # EDITOR, .vimrc, the vi alias
brew "gnupg"
brew "pinentry-mac" # gpg-agent's pinentry-program
brew "ykman"        # gpg-setup.sh --hardware, and ykwhich
brew "git-lfs"
brew "shellcheck" # ./test.sh
