# APT packages the dotfiles configs rely on.
# (Linux ls is already GNU, so no coreutils needed here.)

# curl is for setup's downloads, not a config.
curl
git
vim
gnupg
xclip
shellcheck

# cargo needs a C linker to link, and rustup doesn't ship one.
build-essential

# Homebrew's installer needs these, with build-essential, curl and git above:
# https://docs.brew.sh/Homebrew-on-Linux#requirements
procps
file

# GitVersion aborts at start without ICU, which a bare Ubuntu 24.04 does not
# have. The name carries the ICU major, so another Ubuntu release may need a
# different one.
libicu74

# pnpm's binary will not start without it.
libatomic1

# The WSL gpg-bridge needs these.
# TODO: WSL-only, so they belong in a WSL-only list (e.g. setup/wsl/packages).
# That needs setup.sh to give WSL its own layer on top of the Linux setup.
socat
