# macOS Finder metadata, written into any folder it opens.
.DS_Store
# Log output from any tool.
*.log
# Personal Claude instructions for one clone.
CLAUDE.local.md
# Claude Code's local-scope settings, personal to this machine. Claude Code
# appends this line to the global excludes file itself if git doesn't ignore it.
**/.claude/settings.local.json
# Empty folder Claude Code stages its own config saves in. Claude Code appends
# this line to the global excludes file itself if git doesn't ignore it.
**/.claude/.cc-writes/
# Claude Code worktrees, each a separate checkout. Claude Code excludes these
# itself only in repos where scheduled tasks have run (.git/info/exclude).
**/.claude/worktrees/
# Claude working files; anything worth keeping goes in the repo's docs/.
**/.claude/tasks/
**/.claude/docs/
